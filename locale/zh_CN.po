msgstr "雇佣向导（%d金币）"

#: scripts/autoload/game_data/GameDataModes.gd:145
msgid "The next party sets out fresh: +3 Resolve."
msgstr "下一支小队精神饱满地出发：+3决心。"

#: scripts/autoload/game_data/GameDataModes.gd:146
msgid "Not needed"
msgstr "不需要"

#: scripts/autoload/game_data/GameDataModes.gd:147
msgid "A war drummer"
