msgstr "恢复时间-15%；在1/3/5级各增加一张床"

#: scripts/autoload/game_data/GameDataModes.gd:789
msgid "Order: Supply Drop — heal the party 35% between fights"
msgstr "命令：补给空投——战斗之间为小队回复35%生命"

