msgid "Ember"
msgstr "余烬"

#: scripts/autoload/game_data/GameDataHeroes.gd:124 scripts/autoload/game_data/GameDataHeroes.gd:792 scripts/autoload/game_data/GameDataHeroes.gd:794
msgid "Frost"
msgstr "冰霜"

#: scripts/autoload/game_data/GameDataHeroes.gd:124 scripts/autoload/game_data/GameDataHeroes.gd:791 scripts/autoload/game_data/GameDataHeroes.gd:793
msgid "Verdant"
msgstr "翠绿"

#: scripts/autoload/game_data/GameDataHeroes.gd:124 scripts/autoload/game_data/GameDataHeroes.gd:780 scripts/autoload/game_data/GameDataHeroes.gd:782
msgid "Umbral"
msgstr "暗影"

