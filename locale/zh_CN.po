msgstr "老兵教官：英雄获得经验+20%"

#: scripts/autoload/game_data/GameDataModes.gd:788 scripts/autoload/game_data/GameDataModes.gd:901
msgid "Infirmary"
msgstr "医务室"

#: scripts/autoload/game_data/GameDataModes.gd:788
