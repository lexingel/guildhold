msgstr "走出沼泽——完成第二幕"

#: scripts/autoload/game_data/GameDataModes.gd:1083
msgid "Crownbreaker — complete Act III"
msgstr "碎冠者——完成第三幕"

#: scripts/autoload/game_data/GameDataModes.gd:1084
msgid "Keeper of the Accord — complete the campaign"
msgstr "盟约守护者——完成战役"

#: scripts/autoload/game_data/GameDataModes.gd:1085
msgid "Rift Warden — seal 25 rifts"
msgstr "裂隙守卫——封印25个裂隙"

#: scripts/autoload/game_data/GameDataModes.gd:1086
msgid "Centurion — defeat 250 monsters"
msgstr "百夫长——击败250个怪物"

#: scripts/autoload/game_data/GameDataModes.gd:1087
msgid "Kingslayer — defeat 20 Bosses"
