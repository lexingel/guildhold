#: scripts/autoload/game_data/GameDataModes.gd:1525
msgid "By Hand"
msgstr "亲力亲为"

#: scripts/autoload/game_data/GameDataModes.gd:1525
msgid "No Quick fight: every fight is played, or set to Auto."
msgstr "禁用快速战斗：每场战斗都要亲自打，或设为自动。"

#: scripts/autoload/game_data/GameDataModes.gd:1526
msgid "Lean Purse"
msgstr "囊中羞涩"

#: scripts/autoload/game_data/GameDataModes.gd:1526
msgid "Wages are 50% higher."
msgstr "薪水提高50%。"

#: scripts/autoload/game_data/GameDataModes.gd:1527
