msgid "The next party marches out to the drum: +4 Resolve."
msgstr "下一支小队随鼓声出征：+4决心。"

#: scripts/autoload/game_data/GameDataModes.gd:149 scripts/autoload/game_data/GameDataModes.gd:177 scripts/autoload/game_state/GameStateBreach.gd:552
msgid "Not today"
msgstr "今天不行"

