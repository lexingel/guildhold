#: scripts/autoload/game_data/GameDataChampions.gd:41
msgid "The knight who asked for the deepest post, under a city nobody on our side has seen, and held its door with his shoulder for twenty years. The chains are still on his wrists; he says they help him remember why."
msgstr "El caballero que pidió el puesto más profundo, bajo una ciudad que nadie de nuestro lado ha visto, y sostuvo su puerta con el hombro durante veinte años. Aún lleva las cadenas en las muñecas; dice que le ayudan a recordar por qué."

#: scripts/autoload/game_data/GameDataChampions.gd:42
msgid "Unbroken Line"
msgstr "Línea Inquebrantable"

#: scripts/autoload/game_data/GameDataChampions.gd:43 scripts/autoload/game_data/GameDataHeroes.gd:647 scripts/autoload/game_data/GameDataSkills.gd:362
msgid "Last Stand"
msgstr "Última Resistencia"

#: scripts/autoload/game_data/GameDataChampions.gd:43
msgid "shields every ally for 35% of their max HP"
msgstr "da a cada aliado un escudo del 35% de sus PV máx."

#: scripts/autoload/game_data/GameDataChampions.gd:45
msgid "Grell"
msgstr "Grell"

#: locale/extra_msgids.txt scripts/autoload/game_data/GameDataChampions.gd:45
msgid "Ironjaw"
