msgstr "activa todas las trampas a la vez sobre los enemigos heridos"

#: scripts/autoload/game_data/GameDataChampions.gd:86
msgid "Ossian"
msgstr "Ossian"

#: locale/extra_msgids.txt scripts/autoload/game_data/GameDataChampions.gd:86
msgid "Greyfeather"
msgstr "Plumagrís"

#: scripts/autoload/game_data/GameDataChampions.gd:87
msgid "Has never missed a shot. He will tell you this before you ask."
msgstr "Nunca ha fallado un disparo. Te lo dirá antes de que preguntes."

#: scripts/autoload/game_data/GameDataChampions.gd:88
msgid "First Shot"
msgstr "Primer Disparo"

#: scripts/autoload/game_data/GameDataChampions.gd:89
msgid "Killshot"
msgstr "Tiro de Gracia"

#: scripts/autoload/game_data/GameDataChampions.gd:89
