#: scripts/ui/GuildViews.gd:2216
msgid "Legendaries — %d/%d found"
msgstr "Legendarios — %d/%d encontrados"

#: scripts/ui/GuildViews.gd:2254
msgid "Crafting (Arcane Lab) turns three unequipped items or relics of one kind and rarity into one of the next rarity up."
msgstr "La fabricación (Laboratorio Arcano) convierte tres objetos o reliquias sin equipar de un mismo tipo y rareza en uno de la rareza superior."

