msgstr "pone a la fila delantera una barrera del 50% de sus PV máx."

#: scripts/autoload/game_data/GameDataChampions.gd:60
msgid "Kael"
msgstr "Kael"

#: locale/extra_msgids.txt scripts/autoload/game_data/GameDataChampions.gd:60
msgid "the Oathsworn"
msgstr "el Juramentado"

#: scripts/autoload/game_data/GameDataChampions.gd:61
msgid "Swore to guard a rift-gate until relieved. Nobody came. He is very glad to see you."
msgstr "Juró custodiar una puerta de grieta hasta que lo relevaran. No vino nadie. Se alegra mucho de verte."

#: scripts/autoload/game_data/GameDataChampions.gd:62
