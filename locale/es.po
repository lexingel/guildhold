#: scripts/autoload/game_data/GameDataMonsters.gd:184
msgid "Bold"
msgstr "Audaz"

#: scripts/autoload/game_data/GameDataMonsters.gd:184
msgid "Quick"
msgstr "Veloz"

#: scripts/autoload/game_data/GameDataMonsters.gd:184
msgid "Stoic"
msgstr "Estoico"

#: scripts/autoload/game_data/GameDataMonsters.gd:184
msgid "Nervous"
msgstr "Nervioso"

#: scripts/autoload/game_data/GameDataMonsters.gd:184
msgid "Devout"
msgstr "Devoto"

#: scripts/autoload/game_data/GameDataMonsters.gd:184
msgid "Scholarly"
msgstr "Erudito"

#: scripts/autoload/game_data/GameDataMonsters.gd:187
msgid "Next!"
msgstr "¡El siguiente!"

#: scripts/autoload/game_data/GameDataMonsters.gd:187
msgid "Too easy."
msgstr "Demasiado fácil."

#: scripts/autoload/game_data/GameDataMonsters.gd:187
msgid "Who's next in line?"
msgstr "¿Quién sigue en la fila?"

#: scripts/autoload/game_data/GameDataMonsters.gd:188
msgid "Just a scratch!"
msgstr "¡Solo un rasguño!"

#: scripts/autoload/game_data/GameDataMonsters.gd:188
msgid "That all you've got?"
msgstr "¿Eso es todo lo que tienes?"

#: scripts/autoload/game_data/GameDataMonsters.gd:188
msgid "I've had worse at breakfast."
msgstr "He desayunado cosas peores."

#: scripts/autoload/game_data/GameDataMonsters.gd:189
msgid "You'll pay for that!"
msgstr "¡Me las pagarás!"

#: scripts/autoload/game_data/GameDataMonsters.gd:189
msgid "Hold on, I'll finish this!"
msgstr "¡Aguanta, yo termino esto!"

#: scripts/autoload/game_data/GameDataMonsters.gd:189
msgid "Stay down, I've got it!"
msgstr "¡Quédate en el suelo, yo me encargo!"

#: scripts/autoload/game_data/GameDataMonsters.gd:190
msgid "Ha! Another one for the wall."
msgstr "¡Ja! Otro para la pared."

#: scripts/autoload/game_data/GameDataMonsters.gd:190
msgid "Is that the best the Rift can do?"
msgstr "¿Es lo mejor que tiene la Grieta?"

#: scripts/autoload/game_data/GameDataMonsters.gd:190
msgid "Point me at the next one."
msgstr "Señálame el siguiente."

#: scripts/autoload/game_data/GameDataMonsters.gd:191
msgid "Stronger. Good."
msgstr "Más fuerte. Bien."

#: scripts/autoload/game_data/GameDataMonsters.gd:191
msgid "Now we're talking."
msgstr "Así se habla."

#: scripts/autoload/game_data/GameDataMonsters.gd:191
msgid "Bring on something bigger."
msgstr "Que venga algo más grande."

#: scripts/autoload/game_data/GameDataMonsters.gd:194
msgid "Blink and you missed it."
msgstr "Parpadeaste y te lo perdiste."

#: scripts/autoload/game_data/GameDataMonsters.gd:194
msgid "Clean."
msgstr "Limpio."

#: scripts/autoload/game_data/GameDataMonsters.gd:194
msgid "Right where I aimed."
msgstr "Justo donde apunté."

#: scripts/autoload/game_data/GameDataMonsters.gd:195
msgid "Too slow on that one..."
msgstr "Demasiado lento en ese..."

#: scripts/autoload/game_data/GameDataMonsters.gd:195
msgid "Need to keep moving!"
msgstr "¡Tengo que moverme!"

#: scripts/autoload/game_data/GameDataMonsters.gd:195
msgid "Close. Too close."
msgstr "Cerca. Demasiado cerca."

#: scripts/autoload/game_data/GameDataMonsters.gd:196
msgid "Man down! Covering!"
msgstr "¡Uno caído! ¡Cubriendo!"

#: scripts/autoload/game_data/GameDataMonsters.gd:196
msgid "I'll draw them off!"
msgstr "¡Yo los distraigo!"

#: scripts/autoload/game_data/GameDataMonsters.gd:196
msgid "Get up, get up!"
msgstr "¡Levántate, levántate!"

#: scripts/autoload/game_data/GameDataMonsters.gd:197
msgid "Fast work."
msgstr "Trabajo rápido."

#: scripts/autoload/game_data/GameDataMonsters.gd:197
msgid "Home before supper."
msgstr "En casa antes de la cena."

#: scripts/autoload/game_data/GameDataMonsters.gd:197
msgid "They never saw us coming."
msgstr "Nunca nos vieron venir."

#: scripts/autoload/game_data/GameDataMonsters.gd:198
msgid "Quicker every day."
msgstr "Más rápido cada día."

#: scripts/autoload/game_data/GameDataMonsters.gd:198
msgid "Feeling light on my feet."
msgstr "Me siento ligero de pies."

#: scripts/autoload/game_data/GameDataMonsters.gd:198
msgid "Watch this."
msgstr "Mira esto."

#: scripts/autoload/game_data/GameDataMonsters.gd:201
msgid "It's done."
msgstr "Hecho."

#: scripts/autoload/game_data/GameDataMonsters.gd:201
msgid "One less."
msgstr "Uno menos."

#: scripts/autoload/game_data/GameDataMonsters.gd:201
msgid "Stay down."
msgstr "Quédate en el suelo."

#: scripts/autoload/game_data/GameDataMonsters.gd:202
msgid "I can still stand."
msgstr "Aún puedo mantenerme en pie."

#: scripts/autoload/game_data/GameDataMonsters.gd:202
msgid "Not yet."
msgstr "Todavía no."

#: scripts/autoload/game_data/GameDataMonsters.gd:202
msgid "I hold."
msgstr "Resisto."

#: scripts/autoload/game_data/GameDataMonsters.gd:203
msgid "I'll hold the line."
msgstr "Mantendré la línea."

#: scripts/autoload/game_data/GameDataMonsters.gd:203
msgid "Rest. I'll carry this."
msgstr "Descansa. Yo cargo con esto."

#: scripts/autoload/game_data/GameDataMonsters.gd:203
msgid "Steady. We finish it."
msgstr "Firmes. Lo terminamos."

#: scripts/autoload/game_data/GameDataMonsters.gd:204
msgid "The line held."
msgstr "La línea aguantó."

#: scripts/autoload/game_data/GameDataMonsters.gd:204
msgid "We endure."
msgstr "Resistimos."

#: scripts/autoload/game_data/GameDataMonsters.gd:204
msgid "Another day."
msgstr "Otro día más."

#: scripts/autoload/game_data/GameDataMonsters.gd:205
msgid "Steady progress."
msgstr "Progreso constante."

#: scripts/autoload/game_data/GameDataMonsters.gd:205
msgid "I feel it. Good."
msgstr "Lo siento. Bien."

#: scripts/autoload/game_data/GameDataMonsters.gd:205
msgid "The work pays off."
msgstr "El trabajo da frutos."

#: scripts/autoload/game_data/GameDataMonsters.gd:208
msgid "Did... did I do that?"
msgstr "¿He... he hecho yo eso?"

#: scripts/autoload/game_data/GameDataMonsters.gd:208
msgid "Oh, thank the stars."
msgstr "Ay, gracias a las estrellas."

#: scripts/autoload/game_data/GameDataMonsters.gd:208
msgid "Is it dead? It's dead."
msgstr "¿Está muerto? Está muerto."

#: scripts/autoload/game_data/GameDataMonsters.gd:209
msgid "I don't want to die here!"
msgstr "¡No quiero morir aquí!"

#: scripts/autoload/game_data/GameDataMonsters.gd:209
msgid "Help! Anyone?"
msgstr "¡Ayuda! ¿Alguien?"

#: scripts/autoload/game_data/GameDataMonsters.gd:209
msgid "This was a terrible idea."
msgstr "Esto fue una idea terrible."

#: scripts/autoload/game_data/GameDataMonsters.gd:210
msgid "No, no, no, get up!"
msgstr "¡No, no, no, levántate!"

#: scripts/autoload/game_data/GameDataMonsters.gd:210
msgid "Should we run? We should run."
msgstr "¿Huimos? Deberíamos huir."

#: scripts/autoload/game_data/GameDataMonsters.gd:210
msgid "They got them!"
msgstr "¡Lo han alcanzado!"

#: scripts/autoload/game_data/GameDataMonsters.gd:211
msgid "We lived! We actually lived!"
msgstr "¡Sobrevivimos! ¡De verdad sobrevivimos!"

#: scripts/autoload/game_data/GameDataMonsters.gd:211
msgid "Can we go home now?"
msgstr "¿Podemos ir a casa ya?"

#: scripts/autoload/game_data/GameDataMonsters.gd:211
msgid "Never again. Probably."
msgstr "Nunca más. Probablemente."

#: scripts/autoload/game_data/GameDataMonsters.gd:212
msgid "Huh. I'm getting better at this."
msgstr "Vaya. Esto se me da cada vez mejor."

#: scripts/autoload/game_data/GameDataMonsters.gd:212
msgid "Maybe I'm not so bad after all."
msgstr "Quizá no soy tan malo después de todo."

#: scripts/autoload/game_data/GameDataMonsters.gd:212
msgid "Did I just get stronger?"
msgstr "¿Me acabo de volver más fuerte?"

#: scripts/autoload/game_data/GameDataMonsters.gd:215
msgid "Rest now."
msgstr "Descansa ya."

#: scripts/autoload/game_data/GameDataMonsters.gd:215
msgid "The light judges you."
msgstr "La luz te juzga."

#: scripts/autoload/game_data/GameDataMonsters.gd:215
msgid "Forgiven, and gone."
msgstr "Perdonado, y desaparecido."

#: scripts/autoload/game_data/GameDataMonsters.gd:216
msgid "Grant me strength..."
msgstr "Dame fuerza..."

#: scripts/autoload/game_data/GameDataMonsters.gd:216
msgid "My faith holds, if my body won't."
msgstr "Mi fe aguanta, aunque mi cuerpo no."

#: scripts/autoload/game_data/GameDataMonsters.gd:216
msgid "Not while they need me."
msgstr "No mientras me necesiten."

#: scripts/autoload/game_data/GameDataMonsters.gd:217
msgid "I'm coming, hold on!"
msgstr "¡Ya voy, aguanta!"

#: scripts/autoload/game_data/GameDataMonsters.gd:217
msgid "Light, keep them!"
msgstr "¡Luz, protégelos!"

#: scripts/autoload/game_data/GameDataMonsters.gd:217
msgid "Don't you dare give up!"
msgstr "¡Ni se te ocurra rendirte!"

#: scripts/autoload/game_data/GameDataMonsters.gd:218
msgid "Light guide us home."
msgstr "Que la luz nos guíe a casa."

#: scripts/autoload/game_data/GameDataMonsters.gd:218
msgid "We were spared. Give thanks."
msgstr "Fuimos perdonados. Den gracias."

#: scripts/autoload/game_data/GameDataMonsters.gd:218
msgid "Let's tend the wounded."
msgstr "Atendamos a los heridos."

#: scripts/autoload/game_data/GameDataMonsters.gd:219
msgid "A blessing."
msgstr "Una bendición."

#: scripts/autoload/game_data/GameDataMonsters.gd:219
msgid "I am given more to give."
msgstr "Se me da más para dar."

#: scripts/autoload/game_data/GameDataMonsters.gd:219
msgid "My purpose grows clearer."
msgstr "Mi propósito se aclara."

#: scripts/autoload/game_data/GameDataMonsters.gd:222
msgid "Unmade."
msgstr "Deshecho."

#: scripts/autoload/game_data/GameDataMonsters.gd:222
msgid "Just as I calculated."
msgstr "Tal como lo calculé."

#: scripts/autoload/game_data/GameDataMonsters.gd:222
msgid "Fascinating. Was."
msgstr "Fascinante. Era."

#: scripts/autoload/game_data/GameDataMonsters.gd:223
msgid "Variables... unfavorable."
msgstr "Variables... desfavorables."

#: scripts/autoload/game_data/GameDataMonsters.gd:223
msgid "The weave is fraying. So am I."
msgstr "El tejido se deshilacha. Y yo también."

#: scripts/autoload/game_data/GameDataMonsters.gd:223
msgid "I need a moment to recompute!"
msgstr "¡Necesito un momento para recalcular!"

#: scripts/autoload/game_data/GameDataMonsters.gd:224
msgid "That was not in the plan!"
msgstr "¡Eso no estaba en el plan!"

#: scripts/autoload/game_data/GameDataMonsters.gd:224
msgid "Recalculating!"
msgstr "¡Recalculando!"

#: scripts/autoload/game_data/GameDataMonsters.gd:224
msgid "Someone get them up!"
msgstr "¡Que alguien lo levante!"

#: scripts/autoload/game_data/GameDataMonsters.gd:225
msgid "A tidy result."
msgstr "Un resultado pulcro."

#: scripts/autoload/game_data/GameDataMonsters.gd:225
msgid "Worth a page in my notes."
msgstr "Merece una página en mis notas."

#: scripts/autoload/game_data/GameDataMonsters.gd:225
msgid "The Rift has patterns. I see them now."
msgstr "La Grieta tiene patrones. Ahora los veo."

#: scripts/autoload/game_data/GameDataMonsters.gd:226
msgid "The equations open up."
msgstr "Las ecuaciones se abren."

#: scripts/autoload/game_data/GameDataMonsters.gd:226
msgid "More power. Excellent."
msgstr "Más poder. Excelente."

#: scripts/autoload/game_data/GameDataMonsters.gd:226
msgid "I understand more now."
msgstr "Ahora entiendo más."

#: scripts/autoload/game_data/GameDataMonsters.gd:241
msgid "Call the Horde"
msgstr "Llamar a la horda"

#: scripts/autoload/game_data/GameDataMonsters.gd:241
msgid "At half health, two foes answer its call."
msgstr "A media salud, dos enemigos responden a su llamada."

#: scripts/autoload/game_data/GameDataMonsters.gd:241
msgid "%s howls, and the rift answers with reinforcements!"
msgstr "¡%s aúlla, y la grieta responde con refuerzos!"

#: scripts/autoload/game_data/GameDataMonsters.gd:242
msgid "Fury"
msgstr "Furia"

#: scripts/autoload/game_data/GameDataMonsters.gd:242
msgid "At half health it hits 20% harder and winds up heavy blows more often."
msgstr "A media salud golpea un 20% más fuerte y carga golpes pesados más a menudo."

#: scripts/autoload/game_data/GameDataMonsters.gd:242
msgid "%s roars in fury!"
msgstr "¡%s ruge de furia!"

#: scripts/autoload/game_data/GameDataMonsters.gd:243
msgid "At half health it raises a ward worth 12% of its health."
msgstr "A media salud alza una barrera equivalente al 12% de su salud."

#: scripts/autoload/game_data/GameDataMonsters.gd:243
msgid "%s raises a shimmering barrier!"
msgstr "¡%s alza una barrera reluciente!"

#: scripts/autoload/game_data/GameDataMonsters.gd:250
msgid "Vampiric"
msgstr "Vampírico"

#: scripts/autoload/game_data/GameDataMonsters.gd:250
msgid "Heals for 25% of the damage it deals."
msgstr "Se cura un 25% del daño que inflige."

#: scripts/autoload/game_data/GameDataMonsters.gd:251
msgid "Thorned"
msgstr "Espinoso"

#: scripts/autoload/game_data/GameDataMonsters.gd:251
msgid "Reflects 15% of the damage it takes back at the attacker."
msgstr "Refleja al atacante un 15% del daño que recibe."

#: scripts/autoload/game_data/GameDataMonsters.gd:252
msgid "Shielded"
msgstr "Escudado"

#: scripts/autoload/game_data/GameDataMonsters.gd:252
msgid "Starts behind a ward worth 20% of its health."
msgstr "Empieza tras una barrera equivalente al 20% de su salud."

#: scripts/autoload/game_data/GameDataMonsters.gd:253
msgid "Venomous"
msgstr "Venenoso"

#: scripts/autoload/game_data/GameDataMonsters.gd:253
msgid "Its hits poison."
msgstr "Sus golpes envenenan."

#: scripts/autoload/game_data/GameDataMonsters.gd:254
msgid "Juggernaut"
msgstr "Coloso"

#: scripts/autoload/game_data/GameDataMonsters.gd:254
msgid "Heavily armored: shrugs off 35% of basic attacks."
msgstr "Muy acorazado: ignora el 35% de los ataques básicos."

#: scripts/autoload/game_data/GameDataMonsters.gd:255
msgid "Blazing"
msgstr "Llameante"

#: scripts/autoload/game_data/GameDataMonsters.gd:255
msgid "Its hits can set heroes ablaze."
msgstr "Sus golpes pueden prender fuego a los héroes."

#: scripts/autoload/game_data/GameDataMonsters.gd:256
msgid "Hasted"
msgstr "Acelerado"

#: scripts/autoload/game_data/GameDataMonsters.gd:256
msgid "Acts twice each round (each hit a little weaker) and never winds up."
msgstr "Actúa dos veces cada ronda (cada golpe algo más débil) y nunca carga."

#: scripts/autoload/game_data/GameDataMonsters.gd:257
msgid "Commander"
msgstr "Comandante"

#: scripts/autoload/game_data/GameDataMonsters.gd:257
msgid "Always brings two (weaker) escorts."
msgstr "Siempre trae dos escoltas (más débiles)."

#: scripts/autoload/game_data/GameDataMonsters.gd:263
msgid "Wisp"
msgstr "Fuego fatuo"

#: scripts/autoload/game_data/GameDataMonsters.gd:263
msgid "Moth"
msgstr "Polilla"

#: scripts/autoload/game_data/GameDataMonsters.gd:263
msgid "Sprite"
msgstr "Duende"

#: scripts/autoload/game_data/GameDataMonsters.gd:263
msgid "Oracle"
msgstr "Oráculo"

#: scripts/autoload/game_data/GameDataMonsters.gd:263
msgid "Choir"
msgstr "Coro"

#: scripts/autoload/game_data/GameDataMonsters.gd:263
msgid "Sniper"
msgstr "Francotirador"

#: scripts/autoload/game_data/GameDataMonsters.gd:263
msgid "Crier"
msgstr "Pregonero"

#: scripts/autoload/game_data/GameDataMonsters.gd:263
msgid "Harrier"
msgstr "Hostigador"

#: scripts/autoload/game_data/GameDataMonsters.gd:263
msgid "Bellringer"
msgstr "Campanero"

#: scripts/autoload/game_data/GameDataMonsters.gd:263
msgid "Priest"
msgstr "Sacerdote"

#: scripts/autoload/game_data/GameDataMonsters.gd:263
msgid "Wight"
msgstr "Espectro"

#: scripts/autoload/game_data/GameDataMonsters.gd:263
msgid "Caller"
msgstr "Invocador"

#: scripts/autoload/game_data/GameDataMonsters.gd:275
msgid "Sweep"
msgstr "Barrido"

#: scripts/autoload/game_data/GameDataMonsters.gd:275
msgid "Hits every hero for %d%% of a normal hit. Defend halves it for whoever Defends."
msgstr "Golpea a cada héroe por el %d%% de un golpe normal. Defender lo reduce a la mitad para quien Defiende."

#: scripts/autoload/game_data/GameDataMonsters.gd:276
msgid "Snipe"
msgstr "Disparo letal"

#: scripts/autoload/game_data/GameDataMonsters.gd:276
msgid "A heavier shot at the most-hurt hero in the back row. Guard can take it for them."
msgstr "Un disparo más fuerte al héroe más herido de la fila trasera. Proteger puede recibirlo por él."

#: scripts/autoload/game_data/GameDataMonsters.gd:277
msgid "Curse"
msgstr "Maldición"

#: scripts/autoload/game_data/GameDataMonsters.gd:277
msgid "No damage, but the target deals 40%% less for 2 rounds. Sanctuary cleanses it."
msgstr "Sin daño, pero el objetivo inflige un 40%% menos durante 2 rondas. Santuario lo purifica."

#: scripts/autoload/game_data/GameDataMonsters.gd:278
msgid "Ward"
msgstr "Barrera"

#: scripts/autoload/game_data/GameDataMonsters.gd:278
msgid "Shields its most-hurt ally for 20%% of their max HP. Aimed Shot ignores wards."
msgstr "Escuda a su aliado más herido con el 20%% de sus PV máx. Disparo certero ignora las barreras."

#: scripts/autoload/game_data/GameDataMonsters.gd:279
msgid "Heals its most-hurt ally. Kill or stun it first."
msgstr "Cura a su aliado más herido. Mátalo o atúrdelo primero."

#: scripts/autoload/game_data/GameDataMonsters.gd:280
msgid "Roar"
msgstr "Rugido"

#: scripts/autoload/game_data/GameDataMonsters.gd:280
msgid "Every foe hits 20%% harder for the rest of the fight (up to twice). Stun it to stop it."
msgstr "Cada enemigo golpea un 20%% más fuerte el resto del combate (hasta dos veces). Atúrdelo para impedirlo."

#: scripts/autoload/game_data/GameDataMonsters.gd:281
msgid "Stunned"
msgstr "Aturdido"

#: scripts/autoload/game_data/GameDataMonsters.gd:281
msgid "Loses its next action."
msgstr "Pierde su siguiente acción."

#: scripts/autoload/game_data/GameDataMonsters.gd:282
msgid "Hits every hero and heals the boss for half of it. Defend, or ward the party."
msgstr "Golpea a cada héroe y cura al jefe la mitad. Defiende, o protege al grupo con barreras."

#: scripts/autoload/game_data/GameDataMonsters.gd:283
msgid "Drowning Tide"
msgstr "Marea ahogadora"

#: scripts/autoload/game_data/GameDataMonsters.gd:283
msgid "Chills and weakens every hero (they act late and deal 40%% less next round). Sanctuary or a Healing Tonic cleanses it."
msgstr "Congela y debilita a cada héroe (actúan tarde e infligen un 40%% menos la ronda siguiente). Santuario o un Tónico Curativo lo purifican."

#: scripts/autoload/game_data/GameDataMonsters.gd:284
msgid "Sunder"
msgstr "Quebrar"

#: scripts/autoload/game_data/GameDataMonsters.gd:284
msgid "Tears the wards off every front-row hero and hits them hard. Move a hurt hero back, or Defend."
msgstr "Arranca las barreras de cada héroe de la fila delantera y los golpea con fuerza. Retrasa a un héroe herido, o Defiende."

#: scripts/autoload/game_data/GameDataMonsters.gd:285
msgid "Brand"
msgstr "Marca ígnea"

#: scripts/autoload/game_data/GameDataMonsters.gd:285
msgid "Marks a hero: they take 50%% more damage for 2 rounds. Guard them."
msgstr "Marca a un héroe: recibe un 50%% más de daño durante 2 rondas. Protégelo."

#: scripts/autoload/game_data/GameDataMonsters.gd:286
msgid "Immolate"
msgstr "Inmolar"

#: scripts/autoload/game_data/GameDataMonsters.gd:286
msgid "Sets every hero burning for 3 rounds. Sanctuary or a Healing Tonic puts it out."
msgstr "Hace arder a cada héroe durante 3 rondas. Santuario o un Tónico Curativo lo apagan."

#: scripts/autoload/game_data/GameDataMonsters.gd:321
msgid "Scarecrow Line"
msgstr "Hilera de espantapájaros"

#: scripts/autoload/game_data/GameDataMonsters.gd:321
msgid "The Warden wards its friends and the Wisp mends them. Take the Wisp first, or strip the wards."
msgstr "El Guardián protege a sus aliados con barreras y el Fuego fatuo los cura. Ve primero a por el Fuego fatuo, o quita las barreras."

#: scripts/autoload/game_data/GameDataMonsters.gd:323
msgid "Murder of Crows"
msgstr "Bandada de cuervos"

#: scripts/autoload/game_data/GameDataMonsters.gd:323
msgid "Criers curse and roar from the back. Silence them before the roars stack."
msgstr "Los Pregoneros maldicen y rugen desde atrás. Silénciales antes de que se acumulen los rugidos."

#: scripts/autoload/game_data/GameDataMonsters.gd:325
msgid "Rootbound Ambush"
msgstr "Emboscada enraizada"

#: scripts/autoload/game_data/GameDataMonsters.gd:325
msgid "The Thrall's sweeps hit the whole party. Defend, or stun its wind-up."
msgstr "Los barridos del Siervo golpean a todo el grupo. Defiende, o aturde su carga."

#: scripts/autoload/game_data/GameDataMonsters.gd:327
msgid "Graveyard Shift"
msgstr "Turno de cementerio"

#: scripts/autoload/game_data/GameDataMonsters.gd:327
msgid "The Crawler mends the Reaver while the Crier curses. Break the healer, then the brute."
msgstr "El Reptador cura al Saqueador mientras el Pregonero maldice. Rompe al sanador, luego al bruto."

#: scripts/autoload/game_data/GameDataMonsters.gd:329
msgid "Stalker Pack"
msgstr "Manada de acechadores"

#: scripts/autoload/game_data/GameDataMonsters.gd:329
msgid "Poison stacks fast. A Healing Tonic or Sanctuary washes it out."
msgstr "El veneno se acumula rápido. Un Tónico Curativo o Santuario lo eliminan."

#: scripts/autoload/game_data/GameDataMonsters.gd:331
msgid "The Hunt"
msgstr "La cacería"

#: scripts/autoload/game_data/GameDataMonsters.gd:331
msgid "The Hounds go for your most-hurt back-row hero and their bites fester, while the Crier curses. Guard the back row."
msgstr "Los Sabuesos van a por tu héroe más herido de la fila trasera y sus mordiscos se infectan, mientras el Pregonero maldice. Protege la fila trasera."

#: scripts/autoload/game_data/GameDataMonsters.gd:333
msgid "Lantern Wake"
msgstr "Velatorio del farol"

#: scripts/autoload/game_data/GameDataMonsters.gd:333
msgid "The Wight wards and mends the Reaver from the back. Snuff the lantern first, or the Reaver never falls."
msgstr "El Espectro protege y cura al Saqueador desde atrás. Apaga primero el farol, o el Saqueador nunca caerá."

#: scripts/autoload/game_data/GameDataMonsters.gd:337
msgid "The Leech Mass"
msgstr "La masa de sanguijuelas"

#: scripts/autoload/game_data/GameDataMonsters.gd:337
msgid "The Priest keeps the Wretches fed. Kill it first."
msgstr "El Sacerdote mantiene alimentados a los Desdichados. Mátalo primero."

#: scripts/autoload/game_data/GameDataMonsters.gd:339
msgid "Reed Snipers"
msgstr "Francotiradores del juncal"

#: scripts/autoload/game_data/GameDataMonsters.gd:339
msgid "Snipers hunt the back row behind their Anchorite. Guard your healer, or Taunt."
msgstr "Los Francotiradores cazan la fila trasera tras su Anacoreta. Protege a tu sanador, o Provoca."

#: scripts/autoload/game_data/GameDataMonsters.gd:341
msgid "Bell and Mirror"
msgstr "Campana y espejo"

#: scripts/autoload/game_data/GameDataMonsters.gd:341
msgid "The Fiend reflects basic hits and the Bell curses. Skills and Aimed Shot go around the mirror."
msgstr "El Demonio refleja los golpes básicos y la Campana maldice. Las habilidades y Disparo certero esquivan el espejo."

#: scripts/autoload/game_data/GameDataMonsters.gd:343
msgid "Silt Swarm"
msgstr "Enjambre de limo"

#: scripts/autoload/game_data/GameDataMonsters.gd:343
msgid "Three drainers heal off every hit. Volley and Frost Nova hit them all."
msgstr "Tres drenadores se curan con cada golpe. Andanada y Nova de escarcha los alcanzan a todos."

#: scripts/autoload/game_data/GameDataMonsters.gd:345
msgid "Frozen Watch"
msgstr "Guardia helada"

#: scripts/autoload/game_data/GameDataMonsters.gd:345
msgid "Chills slow your turns and the Priest mends. Burst the Priest down."
msgstr "El frío retrasa tus turnos y el Sacerdote cura. Derriba al Sacerdote de golpe."

#: scripts/autoload/game_data/GameDataMonsters.gd:347 scripts/autoload/game_data/GameDataSkills.gd:314
msgid "Rising Tide"
msgstr "Marea creciente"

#: scripts/autoload/game_data/GameDataMonsters.gd:347
msgid "The Caller's waves chill the whole party while the Brute winds up. Stun the wind-up, then drown the Caller."
msgstr "Las olas del Invocador congelan a todo el grupo mientras el Bruto carga. Aturde la carga y luego ahoga al Invocador."

#: scripts/autoload/game_data/GameDataMonsters.gd:349
msgid "Mudslide"
msgstr "Alud de lodo"

#: scripts/autoload/game_data/GameDataMonsters.gd:349
msgid "Two armored drainers and a Priest to feed them. Break the armor, and kill the Priest before it mends."
msgstr "Dos drenadores acorazados y un Sacerdote que los alimenta. Rompe la armadura y mata al Sacerdote antes de que cure."

#: scripts/autoload/game_data/GameDataMonsters.gd:353
msgid "Forge Guard"
msgstr "Guardia de la fragua"

#: scripts/autoload/game_data/GameDataMonsters.gd:353
msgid "The Oracle wards the Golem, and the Golem's sweeps burn. Take the Oracle first."
msgstr "El Oráculo protege al Gólem con barreras, y los barridos del Gólem queman. Ve primero a por el Oráculo."

#: scripts/autoload/game_data/GameDataMonsters.gd:355
msgid "Ash Flock"
msgstr "Bandada de ceniza"

#: scripts/autoload/game_data/GameDataMonsters.gd:355
msgid "Harriers snipe and hit harder when hurt. Finish each one quickly."
msgstr "Los Hostigadores disparan y golpean más fuerte cuando están heridos. Acaba con cada uno rápido."

#: scripts/autoload/game_data/GameDataMonsters.gd:357
msgid "Cinder Cult"
msgstr "Culto de la ceniza"

#: scripts/autoload/game_data/GameDataMonsters.gd:357
msgid "Everything here burns. Keep a cleanse ready."
msgstr "Aquí todo arde. Ten lista una purificación."

#: scripts/autoload/game_data/GameDataMonsters.gd:359
msgid "Void Tear"
msgstr "Desgarro del vacío"

#: scripts/autoload/game_data/GameDataMonsters.gd:359
msgid "The Reaver winds up while the Sprites harry. Break the wind-up."
msgstr "El Saqueador carga mientras los Duendes hostigan. Rompe la carga."

#: scripts/autoload/game_data/GameDataMonsters.gd:361
msgid "Molten Wall"
msgstr "Muro fundido"

#: scripts/autoload/game_data/GameDataMonsters.gd:361
msgid "Two armored brutes. Armor breakers and stuns shine here."
msgstr "Dos brutos acorazados. Los rompearmaduras y los aturdimientos brillan aquí."

#: scripts/autoload/game_data/GameDataMonsters.gd:363
msgid "Cinder Kennels"
msgstr "Perreras de ceniza"

#: scripts/autoload/game_data/GameDataMonsters.gd:363
msgid "The Hounds roar each other on and grow wild when hurt. Stun the roar and finish each Hound quickly."
msgstr "Los Sabuesos se azuzan con rugidos y se enloquecen al estar heridos. Aturde el rugido y acaba con cada Sabueso rápido."

#: scripts/autoload/game_data/GameDataMonsters.gd:365
msgid "Glass Bastion"
msgstr "Bastión de cristal"

#: scripts/autoload/game_data/GameDataMonsters.gd:365
msgid "The Sentinel reflects basic hits and wards the Harriers. Skills go around the glass; drop the Harriers first."
msgstr "El Centinela refleja los golpes básicos y protege a los Hostigadores. Las habilidades esquivan el cristal; derriba primero a los Hostigadores."

#: scripts/autoload/game_data/GameDataMonsters.gd:369
msgid "The Tideline"
msgstr "La línea de marea"

#: scripts/autoload/game_data/GameDataMonsters.gd:369
msgid "The Priest mends the Brute while the Wisp heals. Take the healers first."
msgstr "El Sacerdote cura al Bruto mientras el Fuego fatuo sana. Ve primero a por los sanadores."

#: scripts/autoload/game_data/GameDataMonsters.gd:371
msgid "Snipers on the Breakwater"
msgstr "Francotiradores en el rompeolas"

#: scripts/autoload/game_data/GameDataMonsters.gd:371
msgid "Two Snipers aim at your back row. Close in, or guard it."
msgstr "Dos Francotiradores apuntan a tu fila trasera. Acércate, o protégela."

#: scripts/autoload/game_data/GameDataMonsters.gd:373
msgid "Crab Wall"
msgstr "Muro de cangrejos"

#: scripts/autoload/game_data/GameDataMonsters.gd:373
msgid "The Crabs drain what they hit. Burst one down at a time."
msgstr "Los Cangrejos drenan lo que golpean. Derríbalos de uno en uno."

#: scripts/autoload/game_data/GameDataMonsters.gd:375
msgid "The Undertow"
msgstr "La resaca"

#: scripts/autoload/game_data/GameDataMonsters.gd:375
msgid "The Tidewalker chills and the Crier curses. Cleanse, then strike."
msgstr "El Caminamareas congela y el Pregonero maldice. Purifica, luego ataca."

#: scripts/autoload/game_data/GameDataMonsters.gd:377
msgid "Salt Pack"
msgstr "Manada de sal"

#: scripts/autoload/game_data/GameDataMonsters.gd:377
msgid "The Hounds get wilder as they bleed. Finish each one quickly."
msgstr "Los Sabuesos se enloquecen al sangrar. Acaba con cada uno rápido."

#: scripts/autoload/game_data/GameDataMonsters.gd:379
msgid "Moths on the Glass"
msgstr "Polillas en el cristal"

#: scripts/autoload/game_data/GameDataMonsters.gd:379
msgid "The Moths shoot from the back while the Thrall sweeps. Stun its wind-up."
msgstr "Las Polillas disparan desde atrás mientras el Siervo barre. Aturde su carga."

#: scripts/autoload/game_data/GameDataMonsters.gd:381
msgid "The Wreck"
msgstr "El naufragio"

#: scripts/autoload/game_data/GameDataMonsters.gd:381
msgid "A Brute and a Thrall wind up heavy blows together. Answer one, guard the other."
msgstr "Un Bruto y un Siervo cargan golpes pesados a la vez. Responde a uno, protégete del otro."

#: scripts/autoload/game_data/GameDataMonsters.gd:385
msgid "The Night Watch"
msgstr "La guardia nocturna"

#: scripts/autoload/game_data/GameDataMonsters.gd:385
msgid "The Watchman wards its friends. Strip the wards, or go around them."
msgstr "El Vigía protege a sus aliados con barreras. Quítalas, o rodéalas."

#: scripts/autoload/game_data/GameDataMonsters.gd:387
msgid "Bells Over the Gate"
msgstr "Campanas sobre la puerta"

#: scripts/autoload/game_data/GameDataMonsters.gd:387
msgid "The Bellringers chill and curse from the back. Silence them first."
msgstr "Los Campaneros congelan y maldicen desde atrás. Silénciales primero."

#: scripts/autoload/game_data/GameDataMonsters.gd:389
msgid "Rooftop Run"
msgstr "Carrera por los tejados"

#: scripts/autoload/game_data/GameDataMonsters.gd:389
msgid "The Harriers snipe your back row. Guard it, or kill them fast."
msgstr "Los Hostigadores disparan a tu fila trasera. Protégela, o mátalos rápido."

#: scripts/autoload/game_data/GameDataMonsters.gd:391
msgid "The Choir Loft"
msgstr "El coro alto"

#: scripts/autoload/game_data/GameDataMonsters.gd:391
msgid "The Sprite and the Oracle burn you from behind a Golem. Burst the back row."
msgstr "El Duende y el Oráculo te queman desde detrás de un Gólem. Revienta la fila trasera."

#: scripts/autoload/game_data/GameDataMonsters.gd:393
msgid "Hounds on the Stairs"
msgstr "Sabuesos en la escalera"

#: scripts/autoload/game_data/GameDataMonsters.gd:393
msgid "The Hounds roar each other into a frenzy. Take them one at a time."
msgstr "Los Sabuesos se azuzan hasta el frenesí con rugidos. Enfréntalos de uno en uno."

#: scripts/autoload/game_data/GameDataMonsters.gd:395
msgid "Lamplighters"
msgstr "Faroleros"

#: scripts/autoload/game_data/GameDataMonsters.gd:395
msgid "The Wights mend and ward each other. Kill one before the other can help."
msgstr "Los Espectros se curan y protegen entre sí. Mata a uno antes de que el otro pueda ayudar."

#: scripts/autoload/game_data/GameDataMonsters.gd:397
msgid "The Gate Guard"
msgstr "La guardia de la puerta"

#: scripts/autoload/game_data/GameDataMonsters.gd:397
msgid "The Sentinel wards and the Reaver hits hard. Strip the ward and stun the wind-up."
msgstr "El Centinela protege con barreras y el Saqueador golpea fuerte. Quita la barrera y aturde la carga."

#: scripts/autoload/game_data/GameDataMonsters.gd:410
msgid "Her Harvest hits everyone and heals her. At half health she calls a Crier and a Warden. Defend through the Harvest; kill the Crier fast."
msgstr "Su Cosecha golpea a todos y la cura. A media salud llama a un Pregonero y a un Guardián. Defiende durante la Cosecha; mata rápido al Pregonero."

#: scripts/autoload/game_data/GameDataMonsters.gd:412 scripts/autoload/game_data/GameDataMonsters.gd:427
msgid "The Drowning Tide chills and weakens the whole party, and her ward shrugs off early defence. Cleanse the curse; save your burst for after her barrier rises."
msgstr "La Marea ahogadora congela y debilita a todo el grupo, y su barrera ignora la defensa temprana. Purifica la maldición; guarda tu ráfaga para después de que alce su barrera."

#: scripts/autoload/game_data/GameDataMonsters.gd:414
msgid "Sunder tears the wards off the front row and hits hard, and he angers every round. Rotate the front row and end it quickly."
msgstr "Quebrar arranca las barreras de la fila delantera y golpea fuerte, y él se enfurece cada ronda. Rota la fila delantera y acaba rápido."

#: scripts/autoload/game_data/GameDataMonsters.gd:416
msgid "Brand marks a hero to take 50% more damage. At half health he calls fire cultists. Guard the branded hero."
msgstr "Marca ígnea hace que un héroe reciba un 50% más de daño. A media salud llama a cultistas del fuego. Protege al héroe marcado."

#: scripts/autoload/game_data/GameDataMonsters.gd:421
msgid "Morrow brands his mark and his crossbowmen take the shot. At two-thirds and again at one-third health he whistles up more sellswords. Guard the branded hero."
msgstr "Morrow marca a su objetivo y sus ballesteros disparan. A dos tercios y de nuevo a un tercio de salud silba para llamar a más mercenarios. Protege al héroe marcado."

#: scripts/autoload/game_data/GameDataMonsters.gd:423
msgid "The bargain fights with every move it ever bought: Harvest, the Drowning Tide, Brand and Immolate. At half health it calls up what it has claimed. Cleanse, guard the branded, and keep the pressure on."
msgstr "El pacto lucha con cada movimiento que alguna vez compró: Cosecha, la Marea ahogadora, Marca ígnea e Inmolar. A media salud invoca lo que ha reclamado. Purifica, protege al marcado y mantén la presión."

#: scripts/autoload/game_data/GameDataMonsters.gd:425
msgid "Immolate sets the whole party burning while she regenerates and grows angrier. Cleanse the burns and never let up."
msgstr "Inmolar hace arder a todo el grupo mientras ella se regenera y se enfurece más. Purifica las quemaduras y no aflojes nunca."

#: scripts/autoload/game_data/GameDataMonsters.gd:429
msgid "The Falling Sky sets the whole party burning while it mends itself and grows angrier. Cleanse the burns and never let up."
msgstr "El Cielo que Cae hace arder a todo el grupo mientras se cura y se enfurece más. Purifica las quemaduras y no aflojes nunca."

#: scripts/autoload/game_data/GameDataMonsters.gd:431
msgid "Brand marks a hero to take 50% more damage. At half health he calls the City's choir down from the rooftops. Guard the branded hero."
msgstr "Marca ígnea hace que un héroe reciba un 50% más de daño. A media salud hace bajar de los tejados al coro de la Ciudad. Protege al héroe marcado."

#: scripts/autoload/game_data/GameDataPaths.gd:10
msgid "the one who stands in front."
msgstr "el que se planta delante."

#: scripts/autoload/game_data/GameDataPaths.gd:10
msgid "from the front row, takes 25% of every hit aimed at a back-row ally."
msgstr "desde la fila delantera, recibe el 25% de cada golpe dirigido a un aliado de la fila trasera."

#: scripts/autoload/game_data/GameDataPaths.gd:10
msgid "Hold the Line"
msgstr "Mantener la línea"

#: scripts/autoload/game_data/GameDataPaths.gd:10
msgid "until the round ends, takes every hit aimed at the back row, at 30% less."
msgstr "hasta que acabe la ronda, recibe cada golpe dirigido a la fila trasera, con un 30% menos."

#: scripts/autoload/game_data/GameDataPaths.gd:10
msgid "the first time an ally would fall, they take the blow instead, gain a ward of 30% max HP, and every foe must attack them for 2 rounds."
msgstr "la primera vez que un aliado vaya a caer, recibe el golpe en su lugar, gana una barrera del 30% de sus PV máx., y todos los enemigos deben atacarle durante 2 rondas."

#: scripts/autoload/game_data/GameDataPaths.gd:10
msgid "Guardian covers front-row allies too."
msgstr "Custodio también cubre a los aliados de la fila delantera."

#: scripts/autoload/game_data/GameDataPaths.gd:11
msgid "Bloodrage"
msgstr "Furia Sangrienta"

#: scripts/autoload/game_data/GameDataPaths.gd:11
msgid "gets stronger as they bleed."
msgstr "se hace más fuerte al sangrar."

#: scripts/autoload/game_data/GameDataPaths.gd:11
msgid "+1% damage for every 2% of HP missing."
msgstr "+1% de daño por cada 2% de PV perdidos."

#: scripts/autoload/game_data/GameDataPaths.gd:11
msgid "Blood Price"
msgstr "Precio de sangre"

#: scripts/autoload/game_data/GameDataPaths.gd:11
msgid "pay 15% HP (no Momentum): +2 Momentum and the next hit does +50%."
msgstr "paga un 15% de PV (sin Ímpetu): +2 de Ímpetu y el siguiente golpe hace +50%."

#: scripts/autoload/game_data/GameDataPaths.gd:11
msgid "the first time they drop below 30% HP, for 3 rounds their attacks hit every foe, they can't be stunned, and they can't be healed."
msgstr "la primera vez que baja del 30% de PV, durante 3 rondas sus ataques golpean a todos los enemigos, no puede ser aturdido y no puede ser curado."

