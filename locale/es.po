msgid "Shieldmaiden"
msgstr "Doncella Escudera"

#: scripts/autoload/game_data/GameDataChampions.gd:56
msgid "Her village sank into a rift in a single night. She walked in after it and has been walking ever since."
msgstr "Su aldea se hundió en una grieta en una sola noche. Entró tras ella y no ha dejado de caminar desde entonces."

#: scripts/autoload/game_data/GameDataChampions.gd:57 scripts/autoload/game_data/GameDataPaths.gd:10
msgid "Shieldwall"
msgstr "Muro de Escudos"

#: scripts/autoload/game_data/GameDataChampions.gd:58 scripts/autoload/game_data/GameDataSkills.gd:358
