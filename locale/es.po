#: scripts/autoload/game_data/GameDataChampions.gd:46
msgid "Lost his jaw to a rift-beast and had a better one forged. He has not stopped talking since."
msgstr "Perdió la mandíbula ante una bestia de grieta y se forjó una mejor. No ha dejado de hablar desde entonces."

#: scripts/autoload/game_data/GameDataChampions.gd:47
msgid "Iron Resolve"
msgstr "Temple de Hierro"

#: scripts/autoload/game_data/GameDataChampions.gd:48
msgid "War Cry"
msgstr "Grito de Guerra"

#: scripts/autoload/game_data/GameDataChampions.gd:48
msgid "the whole party hits 25% harder for the rest of the fight"
msgstr "todo el grupo golpea un 25% más fuerte el resto del combate"

#: scripts/autoload/game_data/GameDataChampions.gd:50
msgid "Mordrake"
msgstr "Mordrake"

#: locale/extra_msgids.txt scripts/autoload/game_data/GameDataChampions.gd:50
msgid "the Deathless"
msgstr "el Inmortal"

#: scripts/autoload/game_data/GameDataChampions.gd:51
msgid "He died in the Endless Rift once. It didn't take."
msgstr "Murió una vez en la Grieta Infinita. No funcionó."

#: scripts/autoload/game_data/GameDataChampions.gd:52
msgid "Grim Momentum"
msgstr "Ímpetu Sombrío"

#: scripts/autoload/game_data/GameDataChampions.gd:53
msgid "Deathless"
msgstr "Inmortal"

#: scripts/autoload/game_data/GameDataChampions.gd:53
msgid "braces the party against a wipe for the rest of the fight"
msgstr "protege al grupo de una derrota total el resto del combate"

#: scripts/autoload/game_data/GameDataChampions.gd:55
