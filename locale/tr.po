#: scripts/autoload/game_data/GameDataMonsters.gd:184
msgid "Bold"
msgstr "Cesur"

#: scripts/autoload/game_data/GameDataMonsters.gd:184
msgid "Quick"
msgstr "Çevik"

#: scripts/autoload/game_data/GameDataMonsters.gd:184
msgid "Stoic"
msgstr "Metin"

#: scripts/autoload/game_data/GameDataMonsters.gd:184
msgid "Nervous"
msgstr "Gergin"

#: scripts/autoload/game_data/GameDataMonsters.gd:184
msgid "Devout"
msgstr "Dindar"

#: scripts/autoload/game_data/GameDataMonsters.gd:184
msgid "Scholarly"
msgstr "Bilgin"

#: scripts/autoload/game_data/GameDataMonsters.gd:187
msgid "Next!"
msgstr "Sıradaki!"

#: scripts/autoload/game_data/GameDataMonsters.gd:187
msgid "Too easy."
msgstr "Çok kolay."

#: scripts/autoload/game_data/GameDataMonsters.gd:187
msgid "Who's next in line?"
msgstr "Sırada kim var?"

#: scripts/autoload/game_data/GameDataMonsters.gd:188
msgid "Just a scratch!"
msgstr "Sadece bir çizik!"

#: scripts/autoload/game_data/GameDataMonsters.gd:188
msgid "That all you've got?"
msgstr "Hepsi bu mu?"

#: scripts/autoload/game_data/GameDataMonsters.gd:188
msgid "I've had worse at breakfast."
msgstr "Kahvaltıda bundan betersini yedim."

#: scripts/autoload/game_data/GameDataMonsters.gd:189
msgid "You'll pay for that!"
msgstr "Bunu ödeyeceksin!"

#: scripts/autoload/game_data/GameDataMonsters.gd:189
msgid "Hold on, I'll finish this!"
msgstr "Dayanın, bunu ben bitiririm!"

#: scripts/autoload/game_data/GameDataMonsters.gd:189
msgid "Stay down, I've got it!"
msgstr "Yerde kal, ben hallederim!"

#: scripts/autoload/game_data/GameDataMonsters.gd:190
msgid "Ha! Another one for the wall."
msgstr "Ha! Duvara bir tane daha."

#: scripts/autoload/game_data/GameDataMonsters.gd:190
msgid "Is that the best the Rift can do?"
msgstr "Yarığın yapabileceği en iyi şey bu mu?"

#: scripts/autoload/game_data/GameDataMonsters.gd:190
msgid "Point me at the next one."
msgstr "Sıradakini göster."

#: scripts/autoload/game_data/GameDataMonsters.gd:191
msgid "Stronger. Good."
msgstr "Daha güçlü. Güzel."

#: scripts/autoload/game_data/GameDataMonsters.gd:191
msgid "Now we're talking."
msgstr "İşte şimdi oldu."

#: scripts/autoload/game_data/GameDataMonsters.gd:191
msgid "Bring on something bigger."
msgstr "Daha büyüğünü getirin."

#: scripts/autoload/game_data/GameDataMonsters.gd:194
msgid "Blink and you missed it."
msgstr "Göz kırpsan kaçırırdın."

#: scripts/autoload/game_data/GameDataMonsters.gd:194
msgid "Clean."
msgstr "Temiz."

#: scripts/autoload/game_data/GameDataMonsters.gd:194
msgid "Right where I aimed."
msgstr "Tam nişan aldığım yere."

#: scripts/autoload/game_data/GameDataMonsters.gd:195
msgid "Too slow on that one..."
msgstr "O seferinde fazla yavaştım..."

#: scripts/autoload/game_data/GameDataMonsters.gd:195
msgid "Need to keep moving!"
msgstr "Hareket etmeye devam etmeliyim!"

#: scripts/autoload/game_data/GameDataMonsters.gd:195
msgid "Close. Too close."
msgstr "Yakındı. Çok yakındı."

#: scripts/autoload/game_data/GameDataMonsters.gd:196
msgid "Man down! Covering!"
msgstr "Biri düştü! Koruyorum!"

#: scripts/autoload/game_data/GameDataMonsters.gd:196
msgid "I'll draw them off!"
msgstr "Onları ben uzaklaştırırım!"

#: scripts/autoload/game_data/GameDataMonsters.gd:196
msgid "Get up, get up!"
msgstr "Kalk, kalk!"

#: scripts/autoload/game_data/GameDataMonsters.gd:197
msgid "Fast work."
msgstr "Hızlı iş."

#: scripts/autoload/game_data/GameDataMonsters.gd:197
msgid "Home before supper."
msgstr "Akşam yemeğine evdeyiz."

#: scripts/autoload/game_data/GameDataMonsters.gd:197
msgid "They never saw us coming."
msgstr "Geldiğimizi hiç görmediler."

#: scripts/autoload/game_data/GameDataMonsters.gd:198
msgid "Quicker every day."
msgstr "Her gün daha hızlı."

#: scripts/autoload/game_data/GameDataMonsters.gd:198
msgid "Feeling light on my feet."
msgstr "Kendimi hafif hissediyorum."

#: scripts/autoload/game_data/GameDataMonsters.gd:198
msgid "Watch this."
msgstr "İzle."

#: scripts/autoload/game_data/GameDataMonsters.gd:201
msgid "It's done."
msgstr "Bitti."

#: scripts/autoload/game_data/GameDataMonsters.gd:201
msgid "One less."
msgstr "Bir eksik."

#: scripts/autoload/game_data/GameDataMonsters.gd:201
msgid "Stay down."
msgstr "Yerde kal."

#: scripts/autoload/game_data/GameDataMonsters.gd:202
msgid "I can still stand."
msgstr "Hâlâ ayaktayım."

#: scripts/autoload/game_data/GameDataMonsters.gd:202
msgid "Not yet."
msgstr "Henüz değil."

#: scripts/autoload/game_data/GameDataMonsters.gd:202
msgid "I hold."
msgstr "Dayanıyorum."

#: scripts/autoload/game_data/GameDataMonsters.gd:203
msgid "I'll hold the line."
msgstr "Hattı ben tutarım."

#: scripts/autoload/game_data/GameDataMonsters.gd:203
msgid "Rest. I'll carry this."
msgstr "Dinlen. Bunu ben taşırım."

#: scripts/autoload/game_data/GameDataMonsters.gd:203
msgid "Steady. We finish it."
msgstr "Sakin. Bunu bitireceğiz."

#: scripts/autoload/game_data/GameDataMonsters.gd:204
msgid "The line held."
msgstr "Hat dayandı."

#: scripts/autoload/game_data/GameDataMonsters.gd:204
msgid "We endure."
msgstr "Dayanıyoruz."

#: scripts/autoload/game_data/GameDataMonsters.gd:204
msgid "Another day."
msgstr "Bir gün daha."

#: scripts/autoload/game_data/GameDataMonsters.gd:205
msgid "Steady progress."
msgstr "İstikrarlı ilerleme."

#: scripts/autoload/game_data/GameDataMonsters.gd:205
msgid "I feel it. Good."
msgstr "Hissediyorum. Güzel."

#: scripts/autoload/game_data/GameDataMonsters.gd:205
msgid "The work pays off."
msgstr "Emek karşılığını veriyor."

#: scripts/autoload/game_data/GameDataMonsters.gd:208
msgid "Did... did I do that?"
msgstr "Bunu... ben mi yaptım?"

#: scripts/autoload/game_data/GameDataMonsters.gd:208
msgid "Oh, thank the stars."
msgstr "Yıldızlara şükür."

#: scripts/autoload/game_data/GameDataMonsters.gd:208
msgid "Is it dead? It's dead."
msgstr "Öldü mü? Öldü."

#: scripts/autoload/game_data/GameDataMonsters.gd:209
msgid "I don't want to die here!"
msgstr "Burada ölmek istemiyorum!"

#: scripts/autoload/game_data/GameDataMonsters.gd:209
msgid "Help! Anyone?"
msgstr "İmdat! Kimse yok mu?"

#: scripts/autoload/game_data/GameDataMonsters.gd:209
msgid "This was a terrible idea."
msgstr "Bu berbat bir fikirdi."

#: scripts/autoload/game_data/GameDataMonsters.gd:210
msgid "No, no, no, get up!"
msgstr "Hayır, hayır, hayır, kalk!"

#: scripts/autoload/game_data/GameDataMonsters.gd:210
msgid "Should we run? We should run."
msgstr "Kaçsak mı? Kaçalım."

#: scripts/autoload/game_data/GameDataMonsters.gd:210
msgid "They got them!"
msgstr "Onu yakaladılar!"

#: scripts/autoload/game_data/GameDataMonsters.gd:211
msgid "We lived! We actually lived!"
msgstr "Yaşıyoruz! Gerçekten yaşıyoruz!"

#: scripts/autoload/game_data/GameDataMonsters.gd:211
msgid "Can we go home now?"
msgstr "Artık eve gidebilir miyiz?"

#: scripts/autoload/game_data/GameDataMonsters.gd:211
msgid "Never again. Probably."
msgstr "Bir daha asla. Muhtemelen."

#: scripts/autoload/game_data/GameDataMonsters.gd:212
msgid "Huh. I'm getting better at this."
msgstr "Hm. Bunda iyileşiyorum."

#: scripts/autoload/game_data/GameDataMonsters.gd:212
msgid "Maybe I'm not so bad after all."
msgstr "Belki de o kadar kötü değilimdir."

#: scripts/autoload/game_data/GameDataMonsters.gd:212
msgid "Did I just get stronger?"
msgstr "Az önce güçlendim mi?"

#: scripts/autoload/game_data/GameDataMonsters.gd:215
msgid "Rest now."
msgstr "Artık dinlen."

#: scripts/autoload/game_data/GameDataMonsters.gd:215
msgid "The light judges you."
msgstr "Işık seni yargılıyor."

#: scripts/autoload/game_data/GameDataMonsters.gd:215
msgid "Forgiven, and gone."
msgstr "Affedildi ve gitti."

#: scripts/autoload/game_data/GameDataMonsters.gd:216
msgid "Grant me strength..."
msgstr "Bana güç ver..."

#: scripts/autoload/game_data/GameDataMonsters.gd:216
msgid "My faith holds, if my body won't."
msgstr "Bedenim dayanmasa da inancım dayanıyor."

#: scripts/autoload/game_data/GameDataMonsters.gd:216
msgid "Not while they need me."
msgstr "Bana ihtiyaçları varken olmaz."

#: scripts/autoload/game_data/GameDataMonsters.gd:217
msgid "I'm coming, hold on!"
msgstr "Geliyorum, dayan!"

#: scripts/autoload/game_data/GameDataMonsters.gd:217
msgid "Light, keep them!"
msgstr "Işık, onları koru!"

#: scripts/autoload/game_data/GameDataMonsters.gd:217
msgid "Don't you dare give up!"
msgstr "Sakın pes etme!"

#: scripts/autoload/game_data/GameDataMonsters.gd:218
msgid "Light guide us home."
msgstr "Işık bizi eve götürsün."

#: scripts/autoload/game_data/GameDataMonsters.gd:218
msgid "We were spared. Give thanks."
msgstr "Esirgendik. Şükredin."

#: scripts/autoload/game_data/GameDataMonsters.gd:218
msgid "Let's tend the wounded."
msgstr "Yaralılarla ilgilenelim."

#: scripts/autoload/game_data/GameDataMonsters.gd:219
msgid "A blessing."
msgstr "Bir lütuf."

#: scripts/autoload/game_data/GameDataMonsters.gd:219
msgid "I am given more to give."
msgstr "Vermem için bana daha fazlası verildi."

#: scripts/autoload/game_data/GameDataMonsters.gd:219
msgid "My purpose grows clearer."
msgstr "Amacım netleşiyor."

#: scripts/autoload/game_data/GameDataMonsters.gd:222
msgid "Unmade."
msgstr "Yok edildi."

#: scripts/autoload/game_data/GameDataMonsters.gd:222
msgid "Just as I calculated."
msgstr "Tam hesapladığım gibi."

#: scripts/autoload/game_data/GameDataMonsters.gd:222
msgid "Fascinating. Was."
msgstr "Büyüleyiciydi. Öyleydi."

#: scripts/autoload/game_data/GameDataMonsters.gd:223
msgid "Variables... unfavorable."
msgstr "Değişkenler... elverişsiz."

#: scripts/autoload/game_data/GameDataMonsters.gd:223
msgid "The weave is fraying. So am I."
msgstr "Dokuma sökülüyor. Ben de."

#: scripts/autoload/game_data/GameDataMonsters.gd:223
msgid "I need a moment to recompute!"
msgstr "Yeniden hesaplamak için bir ana ihtiyacım var!"

#: scripts/autoload/game_data/GameDataMonsters.gd:224
msgid "That was not in the plan!"
msgstr "Bu planda yoktu!"

#: scripts/autoload/game_data/GameDataMonsters.gd:224
msgid "Recalculating!"
msgstr "Yeniden hesaplıyorum!"

#: scripts/autoload/game_data/GameDataMonsters.gd:224
msgid "Someone get them up!"
msgstr "Biri onu kaldırsın!"

#: scripts/autoload/game_data/GameDataMonsters.gd:225
msgid "A tidy result."
msgstr "Derli toplu bir sonuç."

#: scripts/autoload/game_data/GameDataMonsters.gd:225
msgid "Worth a page in my notes."
msgstr "Notlarımda bir sayfaya değer."

#: scripts/autoload/game_data/GameDataMonsters.gd:225
msgid "The Rift has patterns. I see them now."
msgstr "Yarığın örüntüleri var. Artık görüyorum."

#: scripts/autoload/game_data/GameDataMonsters.gd:226
msgid "The equations open up."
msgstr "Denklemler açılıyor."

#: scripts/autoload/game_data/GameDataMonsters.gd:226
msgid "More power. Excellent."
msgstr "Daha fazla güç. Mükemmel."

#: scripts/autoload/game_data/GameDataMonsters.gd:226
msgid "I understand more now."
msgstr "Artık daha çok anlıyorum."

#: scripts/autoload/game_data/GameDataMonsters.gd:241
msgid "Call the Horde"
msgstr "Sürüyü Çağır"

#: scripts/autoload/game_data/GameDataMonsters.gd:241
msgid "At half health, two foes answer its call."
msgstr "Yarı canda, iki düşman çağrısına cevap verir."

#: scripts/autoload/game_data/GameDataMonsters.gd:241
msgid "%s howls, and the rift answers with reinforcements!"
msgstr "%s uluyor ve yarık takviyeyle cevap veriyor!"

#: scripts/autoload/game_data/GameDataMonsters.gd:242
msgid "Fury"
msgstr "Hiddet"

#: scripts/autoload/game_data/GameDataMonsters.gd:242
msgid "At half health it hits 20% harder and winds up heavy blows more often."
msgstr "Yarı canda %20 daha sert vurur ve daha sık ağır darbe için güç toplar."

#: scripts/autoload/game_data/GameDataMonsters.gd:242
msgid "%s roars in fury!"
msgstr "%s öfkeyle kükrüyor!"

#: scripts/autoload/game_data/GameDataMonsters.gd:243
msgid "At half health it raises a ward worth 12% of its health."
msgstr "Yarı canda canının %12'si değerinde bir koruma kurar."

#: scripts/autoload/game_data/GameDataMonsters.gd:243
msgid "%s raises a shimmering barrier!"
msgstr "%s parıldayan bir bariyer kuruyor!"

#: scripts/autoload/game_data/GameDataMonsters.gd:250
msgid "Vampiric"
msgstr "Vampirik"

#: scripts/autoload/game_data/GameDataMonsters.gd:250
msgid "Heals for 25% of the damage it deals."
msgstr "Verdiği hasarın %25'i kadar iyileşir."

#: scripts/autoload/game_data/GameDataMonsters.gd:251
msgid "Thorned"
msgstr "Dikenli"

#: scripts/autoload/game_data/GameDataMonsters.gd:251
msgid "Reflects 15% of the damage it takes back at the attacker."
msgstr "Aldığı hasarın %15'ini saldırgana geri yansıtır."

#: scripts/autoload/game_data/GameDataMonsters.gd:252
msgid "Shielded"
msgstr "Kalkanlı"

#: scripts/autoload/game_data/GameDataMonsters.gd:252
msgid "Starts behind a ward worth 20% of its health."
msgstr "Canının %20'si değerinde bir korumanın ardında başlar."

#: scripts/autoload/game_data/GameDataMonsters.gd:253
msgid "Venomous"
msgstr "Zehirli"

#: scripts/autoload/game_data/GameDataMonsters.gd:253
msgid "Its hits poison."
msgstr "Darbeleri zehirler."

#: scripts/autoload/game_data/GameDataMonsters.gd:254
msgid "Juggernaut"
msgstr "Durdurulamaz"

#: scripts/autoload/game_data/GameDataMonsters.gd:254
msgid "Heavily armored: shrugs off 35% of basic attacks."
msgstr "Ağır zırhlı: temel saldırıların %35'ini savuşturur."

#: scripts/autoload/game_data/GameDataMonsters.gd:255
msgid "Blazing"
msgstr "Alevli"

#: scripts/autoload/game_data/GameDataMonsters.gd:255
msgid "Its hits can set heroes ablaze."
msgstr "Darbeleri kahramanları tutuşturabilir."

#: scripts/autoload/game_data/GameDataMonsters.gd:256
msgid "Hasted"
msgstr "Hızlandırılmış"

#: scripts/autoload/game_data/GameDataMonsters.gd:256
msgid "Acts twice each round (each hit a little weaker) and never winds up."
msgstr "Her tur iki kez davranır (her darbe biraz daha zayıf) ve asla güç toplamaz."

#: scripts/autoload/game_data/GameDataMonsters.gd:257
msgid "Commander"
msgstr "Komutan"

#: scripts/autoload/game_data/GameDataMonsters.gd:257
msgid "Always brings two (weaker) escorts."
msgstr "Her zaman iki (daha zayıf) muhafız getirir."

#: scripts/autoload/game_data/GameDataMonsters.gd:263
msgid "Wisp"
msgstr "Peri"

#: scripts/autoload/game_data/GameDataMonsters.gd:263
msgid "Moth"
msgstr "Güve"

#: scripts/autoload/game_data/GameDataMonsters.gd:263
msgid "Sprite"
msgstr "Peri"

#: scripts/autoload/game_data/GameDataMonsters.gd:263
msgid "Oracle"
msgstr "Kâhin"

#: scripts/autoload/game_data/GameDataMonsters.gd:263
msgid "Choir"
msgstr "Koro"

#: scripts/autoload/game_data/GameDataMonsters.gd:263
msgid "Sniper"
msgstr "Nişancı"

#: scripts/autoload/game_data/GameDataMonsters.gd:263
msgid "Crier"
msgstr "Çığırtkan"

#: scripts/autoload/game_data/GameDataMonsters.gd:263
msgid "Harrier"
msgstr "Tacizci"

#: scripts/autoload/game_data/GameDataMonsters.gd:263
msgid "Bellringer"
msgstr "Çan Çalan"

#: scripts/autoload/game_data/GameDataMonsters.gd:263
msgid "Priest"
msgstr "Rahip"

#: scripts/autoload/game_data/GameDataMonsters.gd:263
msgid "Wight"
msgstr "Hortlak"

#: scripts/autoload/game_data/GameDataMonsters.gd:263
msgid "Caller"
msgstr "Çağıran"

#: scripts/autoload/game_data/GameDataMonsters.gd:275
msgid "Sweep"
msgstr "Süpürme"

#: scripts/autoload/game_data/GameDataMonsters.gd:275
msgid "Hits every hero for %d%% of a normal hit. Defend halves it for whoever Defends."
msgstr "Her kahramana normal darbenin %%%d kadarı vurur. Savunan kahraman için Savun bunu yarıya indirir."

#: scripts/autoload/game_data/GameDataMonsters.gd:276
msgid "Snipe"
msgstr "Nişan"

#: scripts/autoload/game_data/GameDataMonsters.gd:276
msgid "A heavier shot at the most-hurt hero in the back row. Guard can take it for them."
msgstr "Arka sıradaki en yaralı kahramana daha ağır bir atış. Koru onun yerine alabilir."

#: scripts/autoload/game_data/GameDataMonsters.gd:277
msgid "Curse"
msgstr "Lanet"

#: scripts/autoload/game_data/GameDataMonsters.gd:277
msgid "No damage, but the target deals 40%% less for 2 rounds. Sanctuary cleanses it."
msgstr "Hasar yok ama hedef 2 tur boyunca %%40 daha az hasar verir. Sığınak temizler."

#: scripts/autoload/game_data/GameDataMonsters.gd:278
msgid "Ward"
msgstr "Koruma"

#: scripts/autoload/game_data/GameDataMonsters.gd:278
msgid "Shields its most-hurt ally for 20%% of their max HP. Aimed Shot ignores wards."
msgstr "En yaralı müttefikine en yüksek canının %%20'si kadar kalkan verir. Nişanlı Atış korumaları yok sayar."

#: scripts/autoload/game_data/GameDataMonsters.gd:279
msgid "Heals its most-hurt ally. Kill or stun it first."
msgstr "En yaralı müttefikini iyileştirir. Önce onu öldür ya da sersemlet."

#: scripts/autoload/game_data/GameDataMonsters.gd:280
msgid "Roar"
msgstr "Kükreme"

#: scripts/autoload/game_data/GameDataMonsters.gd:280
msgid "Every foe hits 20%% harder for the rest of the fight (up to twice). Stun it to stop it."
msgstr "Dövüşün geri kalanında tüm düşmanlar %%20 daha sert vurur (en fazla iki kez). Durdurmak için onu sersemlet."

#: scripts/autoload/game_data/GameDataMonsters.gd:281
msgid "Stunned"
msgstr "Sersemlemiş"

#: scripts/autoload/game_data/GameDataMonsters.gd:281
msgid "Loses its next action."
msgstr "Sonraki hamlesini kaybeder."

#: scripts/autoload/game_data/GameDataMonsters.gd:282
msgid "Hits every hero and heals the boss for half of it. Defend, or ward the party."
msgstr "Her kahramana vurur ve bunun yarısı kadar boss'u iyileştirir. Savun ya da ekibi koru."

#: scripts/autoload/game_data/GameDataMonsters.gd:283
msgid "Drowning Tide"
msgstr "Boğan Dalga"

#: scripts/autoload/game_data/GameDataMonsters.gd:283
msgid "Chills and weakens every hero (they act late and deal 40%% less next round). Sanctuary or a Healing Tonic cleanses it."
msgstr "Her kahramanı üşütür ve zayıflatır (sonraki tur geç davranır ve %%40 daha az hasar verirler). Sığınak ya da Şifa Toniği temizler."

#: scripts/autoload/game_data/GameDataMonsters.gd:284
msgid "Sunder"
msgstr "Parçala"

#: scripts/autoload/game_data/GameDataMonsters.gd:284
msgid "Tears the wards off every front-row hero and hits them hard. Move a hurt hero back, or Defend."
msgstr "Ön sıradaki her kahramanın korumalarını söker ve sert vurur. Yaralı bir kahramanı geri al ya da Savun."

#: scripts/autoload/game_data/GameDataMonsters.gd:285
msgid "Brand"
msgstr "Damga"

#: scripts/autoload/game_data/GameDataMonsters.gd:285
msgid "Marks a hero: they take 50%% more damage for 2 rounds. Guard them."
msgstr "Bir kahramanı işaretler: 2 tur boyunca %%50 daha fazla hasar alır. Onu koru."

#: scripts/autoload/game_data/GameDataMonsters.gd:286
msgid "Immolate"
msgstr "Yakıp Kavur"

#: scripts/autoload/game_data/GameDataMonsters.gd:286
msgid "Sets every hero burning for 3 rounds. Sanctuary or a Healing Tonic puts it out."
msgstr "Her kahramanı 3 tur boyunca yakar. Sığınak ya da Şifa Toniği söndürür."

#: scripts/autoload/game_data/GameDataMonsters.gd:321
msgid "Scarecrow Line"
msgstr "Korkuluk Hattı"

#: scripts/autoload/game_data/GameDataMonsters.gd:321
msgid "The Warden wards its friends and the Wisp mends them. Take the Wisp first, or strip the wards."
msgstr "Bekçi dostlarını korur, Işık Perisi onları iyileştirir. Önce Periyi al ya da korumaları sök."

#: scripts/autoload/game_data/GameDataMonsters.gd:323
msgid "Murder of Crows"
msgstr "Karga Sürüsü"

#: scripts/autoload/game_data/GameDataMonsters.gd:323
msgid "Criers curse and roar from the back. Silence them before the roars stack."
msgstr "Çığırtkanlar arkadan lanetler ve kükrer. Kükremeler birikmeden onları sustur."

#: scripts/autoload/game_data/GameDataMonsters.gd:325
msgid "Rootbound Ambush"
msgstr "Köke Bağlı Pusu"

#: scripts/autoload/game_data/GameDataMonsters.gd:325
msgid "The Thrall's sweeps hit the whole party. Defend, or stun its wind-up."
msgstr "Kölenin süpürmeleri tüm ekibe çarpar. Savun ya da güç toplamasını sersemlet."

#: scripts/autoload/game_data/GameDataMonsters.gd:327
msgid "Graveyard Shift"
msgstr "Mezarlık Nöbeti"

#: scripts/autoload/game_data/GameDataMonsters.gd:327
msgid "The Crawler mends the Reaver while the Crier curses. Break the healer, then the brute."
msgstr "Çığırtkan lanetlerken Sürüngen Biçici'yi iyileştirir. Önce şifacıyı, sonra zorbayı kır."

#: scripts/autoload/game_data/GameDataMonsters.gd:329
msgid "Stalker Pack"
msgstr "Takipçi Sürüsü"

#: scripts/autoload/game_data/GameDataMonsters.gd:329
msgid "Poison stacks fast. A Healing Tonic or Sanctuary washes it out."
msgstr "Zehir hızla birikir. Şifa Toniği ya da Sığınak temizler."

#: scripts/autoload/game_data/GameDataMonsters.gd:331
msgid "The Hunt"
msgstr "Av"

#: scripts/autoload/game_data/GameDataMonsters.gd:331
msgid "The Hounds go for your most-hurt back-row hero and their bites fester, while the Crier curses. Guard the back row."
msgstr "Tazılar arka sıradaki en yaralı kahramanına saldırır ve ısırıkları irinlenir; Çığırtkan da lanet okur. Arka sırayı koru."

#: scripts/autoload/game_data/GameDataMonsters.gd:333
msgid "Lantern Wake"
msgstr "Fener Nöbeti"

#: scripts/autoload/game_data/GameDataMonsters.gd:333
msgid "The Wight wards and mends the Reaver from the back. Snuff the lantern first, or the Reaver never falls."
msgstr "Hortlak arkadan Biçici'yi korur ve iyileştirir. Önce feneri söndür, yoksa Biçici asla düşmez."

#: scripts/autoload/game_data/GameDataMonsters.gd:337
msgid "The Leech Mass"
msgstr "Sülük Yığını"

#: scripts/autoload/game_data/GameDataMonsters.gd:337
msgid "The Priest keeps the Wretches fed. Kill it first."
msgstr "Rahip Sefilleri besliyor. Önce onu öldür."

#: scripts/autoload/game_data/GameDataMonsters.gd:339
msgid "Reed Snipers"
msgstr "Kamış Nişancıları"

#: scripts/autoload/game_data/GameDataMonsters.gd:339
msgid "Snipers hunt the back row behind their Anchorite. Guard your healer, or Taunt."
msgstr "Nişancılar Münzevilerinin ardından arka sırayı avlar. Şifacını koru ya da Kışkırt."

#: scripts/autoload/game_data/GameDataMonsters.gd:341
msgid "Bell and Mirror"
msgstr "Çan ve Ayna"

#: scripts/autoload/game_data/GameDataMonsters.gd:341
msgid "The Fiend reflects basic hits and the Bell curses. Skills and Aimed Shot go around the mirror."
msgstr "İblis temel darbeleri yansıtır, Çan lanetler. Beceriler ve Nişanlı Atış aynayı atlatır."

#: scripts/autoload/game_data/GameDataMonsters.gd:343
msgid "Silt Swarm"
msgstr "Balçık Sürüsü"

#: scripts/autoload/game_data/GameDataMonsters.gd:343
msgid "Three drainers heal off every hit. Volley and Frost Nova hit them all."
msgstr "Üç emici her darbeden iyileşir. Yaylım ve Buz Novası hepsine vurur."

#: scripts/autoload/game_data/GameDataMonsters.gd:345
msgid "Frozen Watch"
msgstr "Donmuş Nöbet"

#: scripts/autoload/game_data/GameDataMonsters.gd:345
msgid "Chills slow your turns and the Priest mends. Burst the Priest down."
msgstr "Üşüme sıralarını yavaşlatır ve Rahip iyileştirir. Rahibi hızla indir."

#: scripts/autoload/game_data/GameDataMonsters.gd:347 scripts/autoload/game_data/GameDataSkills.gd:314
msgid "Rising Tide"
msgstr "Yükselen Dalga"

#: scripts/autoload/game_data/GameDataMonsters.gd:347
msgid "The Caller's waves chill the whole party while the Brute winds up. Stun the wind-up, then drown the Caller."
msgstr "Çağıran'ın dalgaları tüm grubu üşütürken Kaba güç toplar. Güç toplamasını sersemlet, sonra Çağıran'ı boğ."

#: scripts/autoload/game_data/GameDataMonsters.gd:349
msgid "Mudslide"
msgstr "Çamur Seli"

#: scripts/autoload/game_data/GameDataMonsters.gd:349
msgid "Two armored drainers and a Priest to feed them. Break the armor, and kill the Priest before it mends."
msgstr "İki zırhlı emici ve onları besleyen bir Rahip. Zırhı kır ve Rahip iyileştirmeden onu öldür."

#: scripts/autoload/game_data/GameDataMonsters.gd:353
msgid "Forge Guard"
msgstr "Demirhane Muhafızı"

#: scripts/autoload/game_data/GameDataMonsters.gd:353
msgid "The Oracle wards the Golem, and the Golem's sweeps burn. Take the Oracle first."
msgstr "Kâhin Golemi korur, Golemin süpürmeleri yakar. Önce Kâhini al."

#: scripts/autoload/game_data/GameDataMonsters.gd:355
msgid "Ash Flock"
msgstr "Kül Sürüsü"

#: scripts/autoload/game_data/GameDataMonsters.gd:355
msgid "Harriers snipe and hit harder when hurt. Finish each one quickly."
msgstr "Tacizciler nişan alır ve yaralanınca daha sert vurur. Her birini hızla bitir."

#: scripts/autoload/game_data/GameDataMonsters.gd:357
msgid "Cinder Cult"
msgstr "Kor Tarikatı"

#: scripts/autoload/game_data/GameDataMonsters.gd:357
msgid "Everything here burns. Keep a cleanse ready."
msgstr "Burada her şey yanıyor. Bir arındırma hazır tut."

#: scripts/autoload/game_data/GameDataMonsters.gd:359
msgid "Void Tear"
msgstr "Boşluk Yırtığı"

#: scripts/autoload/game_data/GameDataMonsters.gd:359
msgid "The Reaver winds up while the Sprites harry. Break the wind-up."
msgstr "Periler taciz ederken Biçici güç topluyor. Güç toplamayı boz."

#: scripts/autoload/game_data/GameDataMonsters.gd:361
msgid "Molten Wall"
msgstr "Erimiş Duvar"

#: scripts/autoload/game_data/GameDataMonsters.gd:361
msgid "Two armored brutes. Armor breakers and stuns shine here."
msgstr "İki zırhlı zorba. Zırh kırıcılar ve sersemletmeler burada parlar."

#: scripts/autoload/game_data/GameDataMonsters.gd:363
msgid "Cinder Kennels"
msgstr "Kor Köpeklikleri"

#: scripts/autoload/game_data/GameDataMonsters.gd:363
msgid "The Hounds roar each other on and grow wild when hurt. Stun the roar and finish each Hound quickly."
msgstr "Tazılar birbirini kükreyerek kışkırtır ve yaralanınca azgınlaşır. Kükremeyi sersemlet ve her Tazıyı çabucak bitir."

#: scripts/autoload/game_data/GameDataMonsters.gd:365
msgid "Glass Bastion"
msgstr "Cam Burç"

#: scripts/autoload/game_data/GameDataMonsters.gd:365
msgid "The Sentinel reflects basic hits and wards the Harriers. Skills go around the glass; drop the Harriers first."
msgstr "Nöbetçi temel vuruşları yansıtır ve Tacizcileri korur. Beceriler camı aşar; önce Tacizcileri düşür."

#: scripts/autoload/game_data/GameDataMonsters.gd:369
msgid "The Tideline"
msgstr "Gelgit Çizgisi"

#: scripts/autoload/game_data/GameDataMonsters.gd:369
msgid "The Priest mends the Brute while the Wisp heals. Take the healers first."
msgstr "Rahip Kaba'yı onarırken Peri iyileştiriyor. Önce iyileştiricileri al."

#: scripts/autoload/game_data/GameDataMonsters.gd:371
msgid "Snipers on the Breakwater"
msgstr "Dalgakırandaki Nişancılar"

#: scripts/autoload/game_data/GameDataMonsters.gd:371
msgid "Two Snipers aim at your back row. Close in, or guard it."
msgstr "İki Nişancı arka sırana nişan alıyor. Yaklaş ya da arka sırayı koru."

#: scripts/autoload/game_data/GameDataMonsters.gd:373
msgid "Crab Wall"
msgstr "Yengeç Duvarı"

#: scripts/autoload/game_data/GameDataMonsters.gd:373
msgid "The Crabs drain what they hit. Burst one down at a time."
msgstr "Yengeçler vurduklarını emer. Teker teker hızla indir."

#: scripts/autoload/game_data/GameDataMonsters.gd:375
msgid "The Undertow"
msgstr "Dip Akıntısı"

#: scripts/autoload/game_data/GameDataMonsters.gd:375
msgid "The Tidewalker chills and the Crier curses. Cleanse, then strike."
msgstr "Gelgit Yürüyücüsü dondurur, Çığırtkan lanetler. Önce arın, sonra vur."

#: scripts/autoload/game_data/GameDataMonsters.gd:377
msgid "Salt Pack"
msgstr "Tuz Sürüsü"

#: scripts/autoload/game_data/GameDataMonsters.gd:377
msgid "The Hounds get wilder as they bleed. Finish each one quickly."
msgstr "Tazılar kanadıkça azar. Her birini çabucak bitir."

#: scripts/autoload/game_data/GameDataMonsters.gd:379
msgid "Moths on the Glass"
msgstr "Camdaki Güveler"

#: scripts/autoload/game_data/GameDataMonsters.gd:379
msgid "The Moths shoot from the back while the Thrall sweeps. Stun its wind-up."
msgstr "Güveler arkadan ateş ederken Köle süpürür. Hazırlığını sersemlet."

#: scripts/autoload/game_data/GameDataMonsters.gd:381
msgid "The Wreck"
msgstr "Enkaz"

#: scripts/autoload/game_data/GameDataMonsters.gd:381
msgid "A Brute and a Thrall wind up heavy blows together. Answer one, guard the other."
msgstr "Bir Kaba ile bir Köle birlikte ağır darbe hazırlıyor. Birine karşılık ver, diğerine karşı koru."

#: scripts/autoload/game_data/GameDataMonsters.gd:385
msgid "The Night Watch"
msgstr "Gece Nöbeti"

#: scripts/autoload/game_data/GameDataMonsters.gd:385
msgid "The Watchman wards its friends. Strip the wards, or go around them."
msgstr "Bekçi dostlarını korur. Korumaları sök ya da etraflarından dolaş."

#: scripts/autoload/game_data/GameDataMonsters.gd:387
msgid "Bells Over the Gate"
msgstr "Kapının Üstündeki Çanlar"

#: scripts/autoload/game_data/GameDataMonsters.gd:387
msgid "The Bellringers chill and curse from the back. Silence them first."
msgstr "Çan Çalanlar arkadan dondurur ve lanetler. Önce onları sustur."

#: scripts/autoload/game_data/GameDataMonsters.gd:389
msgid "Rooftop Run"
msgstr "Çatı Koşusu"

#: scripts/autoload/game_data/GameDataMonsters.gd:389
msgid "The Harriers snipe your back row. Guard it, or kill them fast."
msgstr "Tacizciler arka sırana nişan alır. Koru ya da onları hızla öldür."

#: scripts/autoload/game_data/GameDataMonsters.gd:391
msgid "The Choir Loft"
msgstr "Koro Balkonu"

#: scripts/autoload/game_data/GameDataMonsters.gd:391
msgid "The Sprite and the Oracle burn you from behind a Golem. Burst the back row."
msgstr "Peri ile Kâhin bir Golem'in arkasından seni yakar. Arka sıralarını hızla indir."

#: scripts/autoload/game_data/GameDataMonsters.gd:393
msgid "Hounds on the Stairs"
msgstr "Merdivendeki Tazılar"

#: scripts/autoload/game_data/GameDataMonsters.gd:393
msgid "The Hounds roar each other into a frenzy. Take them one at a time."
msgstr "Tazılar birbirlerini kükreyerek çıldırtır. Teker teker al."

#: scripts/autoload/game_data/GameDataMonsters.gd:395
msgid "Lamplighters"
msgstr "Lambacılar"

#: scripts/autoload/game_data/GameDataMonsters.gd:395
msgid "The Wights mend and ward each other. Kill one before the other can help."
msgstr "Hortlaklar birbirini onarır ve korur. Diğeri yardım edemeden birini öldür."

#: scripts/autoload/game_data/GameDataMonsters.gd:397
msgid "The Gate Guard"
msgstr "Kapı Muhafızı"

#: scripts/autoload/game_data/GameDataMonsters.gd:397
msgid "The Sentinel wards and the Reaver hits hard. Strip the ward and stun the wind-up."
msgstr "Nöbetçi korur, Biçici sert vurur. Korumayı sök ve hazırlığı sersemlet."

#: scripts/autoload/game_data/GameDataMonsters.gd:410
msgid "Her Harvest hits everyone and heals her. At half health she calls a Crier and a Warden. Defend through the Harvest; kill the Crier fast."
msgstr "Hasadı herkese vurur ve onu iyileştirir. Yarı canda bir Çığırtkan ve bir Bekçi çağırır. Hasat boyunca Savun; Çığırtkanı hızla öldür."

#: scripts/autoload/game_data/GameDataMonsters.gd:412 scripts/autoload/game_data/GameDataMonsters.gd:427
msgid "The Drowning Tide chills and weakens the whole party, and her ward shrugs off early defence. Cleanse the curse; save your burst for after her barrier rises."
msgstr "Boğan Dalga tüm ekibi üşütür ve zayıflatır; koruması erken savunmayı boşa çıkarır. Laneti temizle; en güçlü saldırılarını bariyeri kalktıktan sonraya sakla."

#: scripts/autoload/game_data/GameDataMonsters.gd:414
msgid "Sunder tears the wards off the front row and hits hard, and he angers every round. Rotate the front row and end it quickly."
msgstr "Parçala ön sıranın korumalarını söker ve sert vurur; her tur daha da öfkelenir. Ön sırayı döndür ve işi çabuk bitir."

#: scripts/autoload/game_data/GameDataMonsters.gd:416
msgid "Brand marks a hero to take 50% more damage. At half health he calls fire cultists. Guard the branded hero."
msgstr "Damga bir kahramanı %50 daha fazla hasar alacak şekilde işaretler. Yarı canda ateş tarikatçılarını çağırır. Damgalı kahramanı koru."

#: scripts/autoload/game_data/GameDataMonsters.gd:421
msgid "Morrow brands his mark and his crossbowmen take the shot. At two-thirds and again at one-third health he whistles up more sellswords. Guard the branded hero."
msgstr "Morrow hedefini damgalar ve arbaletçileri atışı yapar. Canı üçte ikiye ve sonra üçte bire inince ıslıkla yeni paralı askerler çağırır. Damgalanan kahramanı koru."

#: scripts/autoload/game_data/GameDataMonsters.gd:423
msgid "The bargain fights with every move it ever bought: Harvest, the Drowning Tide, Brand and Immolate. At half health it calls up what it has claimed. Cleanse, guard the branded, and keep the pressure on."
msgstr "Pazarlık, satın aldığı her hamleyle savaşır: Hasat, Boğan Dalga, Damga ve Yakma. Canı yarıya inince el koyduklarını çağırır. Temizle, damgalıyı koru ve baskıyı sürdür."

#: scripts/autoload/game_data/GameDataMonsters.gd:425
msgid "Immolate sets the whole party burning while she regenerates and grows angrier. Cleanse the burns and never let up."
msgstr "Yakıp Kavur tüm ekibi yakarken o yenilenir ve öfkelenir. Yanıkları temizle ve asla gevşeme."

#: scripts/autoload/game_data/GameDataMonsters.gd:429
msgid "The Falling Sky sets the whole party burning while it mends itself and grows angrier. Cleanse the burns and never let up."
msgstr "Düşen Gök kendini onarıp öfkelenirken bütün ekibi yakar. Yanıkları arındır ve hiç durma."

#: scripts/autoload/game_data/GameDataMonsters.gd:431
msgid "Brand marks a hero to take 50% more damage. At half health he calls the City's choir down from the rooftops. Guard the branded hero."
msgstr "Damga, bir kahramanın %50 daha fazla hasar almasını sağlar. Canı yarıya inince Şehrin korosunu çatılardan çağırır. Damgalı kahramanı koru."

#: scripts/autoload/game_data/GameDataPaths.gd:10
msgid "the one who stands in front."
msgstr "öne geçip duran."

#: scripts/autoload/game_data/GameDataPaths.gd:10
msgid "from the front row, takes 25% of every hit aimed at a back-row ally."
msgstr "ön sıradayken arka sıradaki bir müttefike gelen her darbenin %25'ini üstlenir."

#: scripts/autoload/game_data/GameDataPaths.gd:10
msgid "Hold the Line"
msgstr "Hattı Tut"

#: scripts/autoload/game_data/GameDataPaths.gd:10
msgid "until the round ends, takes every hit aimed at the back row, at 30% less."
msgstr "tur bitene kadar arka sıraya gelen her darbeyi %30 daha az alarak üstlenir."

#: scripts/autoload/game_data/GameDataPaths.gd:10
msgid "the first time an ally would fall, they take the blow instead, gain a ward of 30% max HP, and every foe must attack them for 2 rounds."
msgstr "bir müttefik ilk kez düşecekken darbeyi onun yerine alır, azami canının %30'u kadar bir koruma kazanır ve 2 tur boyunca her düşman ona saldırmak zorunda kalır."

#: scripts/autoload/game_data/GameDataPaths.gd:10
msgid "Guardian covers front-row allies too."
msgstr "Muhafız ön sıradaki müttefikleri de korur."

#: scripts/autoload/game_data/GameDataPaths.gd:11
msgid "Bloodrage"
msgstr "Kan Öfkesi"

#: scripts/autoload/game_data/GameDataPaths.gd:11
msgid "gets stronger as they bleed."
msgstr "kanadıkça güçlenir."

#: scripts/autoload/game_data/GameDataPaths.gd:11
msgid "+1% damage for every 2% of HP missing."
msgstr "Eksik canın her %2'si için +%1 hasar."

#: scripts/autoload/game_data/GameDataPaths.gd:11
msgid "Blood Price"
msgstr "Kan Bedeli"

#: scripts/autoload/game_data/GameDataPaths.gd:11
msgid "pay 15% HP (no Momentum): +2 Momentum and the next hit does +50%."
msgstr "canın %15'ini öde (İvme yok): +2 İvme ve sonraki vuruş +%50 hasar yapar."

#: scripts/autoload/game_data/GameDataPaths.gd:11
msgid "the first time they drop below 30% HP, for 3 rounds their attacks hit every foe, they can't be stunned, and they can't be healed."
msgstr "canı ilk kez %30'un altına düştüğünde 3 tur boyunca saldırıları bütün düşmanları vurur, sersemletilemez ve iyileştirilemez."

#: scripts/autoload/game_data/GameDataPaths.gd:11
msgid "Red Mist triggers at 50% HP."
msgstr "Kızıl Sis %50 canda tetiklenir."

#: scripts/autoload/game_data/GameDataPaths.gd:12
msgid "Weaponmaster"
msgstr "Silah Ustası"

#: scripts/autoload/game_data/GameDataPaths.gd:12
msgid "builds a rhythm on one foe."
msgstr "tek bir düşmanda ritim kurar."

#: scripts/autoload/game_data/GameDataPaths.gd:12
msgid "Combo"
msgstr "Seri"

#: scripts/autoload/game_data/GameDataPaths.gd:12
msgid "each hit in a row on the same foe adds +12% (up to 4); switching targets resets it."
msgstr "aynı düşmana arka arkaya gelen her vuruş +%12 ekler (en fazla 4); hedef değiştirmek seriyi sıfırlar."

#: scripts/autoload/game_data/GameDataPaths.gd:12
msgid "Flurry"
msgstr "Hızlı Darbeler"

#: scripts/autoload/game_data/GameDataPaths.gd:12
msgid "three quick strikes at the target, each adding a Combo stack."
msgstr "hedefe üç hızlı darbe, her biri bir Seri ekler."

#: scripts/autoload/game_data/GameDataPaths.gd:12
msgid "the first time Combo reaches 4, they act twice next round."
msgstr "Seri ilk kez 4'e ulaştığında sonraki tur iki kez davranır."

#: scripts/autoload/game_data/GameDataPaths.gd:12
msgid "switching targets no longer resets Combo."
msgstr "hedef değiştirmek artık Seriyi sıfırlamaz."

#: scripts/autoload/game_data/GameDataPaths.gd:13
msgid "Marksman"
msgstr "Nişancı"

#: scripts/autoload/game_data/GameDataPaths.gd:13
msgid "waits for the clean shot."
msgstr "temiz atışı bekler."

#: scripts/autoload/game_data/GameDataPaths.gd:13
msgid "Steady Aim"
msgstr "Sabit Nişan"

#: scripts/autoload/game_data/GameDataPaths.gd:13
msgid "not attacked last round → the next shot does +35%."
msgstr "geçen tur saldırıya uğramadıysa sonraki atış +%35 hasar yapar."

#: scripts/autoload/game_data/GameDataPaths.gd:13
msgid "Called Shot"
msgstr "Nişanlı Atış"

#: scripts/autoload/game_data/GameDataPaths.gd:13
msgid "pick a foe; the next Steady shot at it also cancels its wind-up."
msgstr "bir düşman seç; ona yapılan sonraki Sabit atış güç toplamasını da bozar."

#: scripts/autoload/game_data/GameDataPaths.gd:13
msgid "Held Breath"
msgstr "Tutulan Nefes"

#: scripts/autoload/game_data/GameDataPaths.gd:13
msgid "the first time they use Called Shot, they hold their turn and fire at the first foe to act next round, with double the Steady bonus."
msgstr "Nişanlı Atış'ı ilk kullandığında sırasını bekler ve sonraki tur ilk davranan düşmana iki kat Sabit bonusuyla ateş eder."

#: scripts/autoload/game_data/GameDataPaths.gd:13
msgid "Steady Aim holds even when they're attacked."
msgstr "Sabit Nişan saldırıya uğrasa bile korunur."

#: scripts/autoload/game_data/GameDataPaths.gd:14
msgid "controls the ground."
msgstr "zemine hükmeder."

#: scripts/autoload/game_data/GameDataPaths.gd:14
msgid "Snares"
msgstr "Tuzaklar"

#: scripts/autoload/game_data/GameDataPaths.gd:14
msgid "each round the first foe to act steps in a snare: light damage, and it acts last next round."
msgstr "her tur ilk davranan düşman bir tuzağa basar: hafif hasar alır ve sonraki tur en son davranır."

#: scripts/autoload/game_data/GameDataPaths.gd:14
msgid "Bait"
msgstr "Yem"

#: scripts/autoload/game_data/GameDataPaths.gd:14
msgid "a lure takes the next foe attack this round (no damage) and snares that foe."
msgstr "bir yem bu tur gelen sonraki düşman saldırısını üstlenir (hasarsız) ve o düşmanı tuzağa düşürür."

#: scripts/autoload/game_data/GameDataPaths.gd:14
msgid "the first time three foes have been snared in a fight, every snared foe takes +30% damage for 2 rounds."
msgstr "bir dövüşte üç düşman ilk kez tuzağa düştüğünde tuzağa düşen her düşman 2 tur boyunca +%30 hasar alır."

#: scripts/autoload/game_data/GameDataPaths.gd:14
msgid "snares also cancel wind-ups."
msgstr "tuzaklar güç toplamalarını da bozar."

#: scripts/autoload/game_data/GameDataPaths.gd:15
msgid "Stalker"
msgstr "Avcı"

#: scripts/autoload/game_data/GameDataPaths.gd:15
msgid "picks the prey for the whole party."
msgstr "bütün ekip için avı seçer."

#: scripts/autoload/game_data/GameDataPaths.gd:15
msgid "Mark"
msgstr "İşaret"

#: scripts/autoload/game_data/GameDataPaths.gd:15
msgid "their first hit marks a foe; the party does +15% to it; the mark jumps to another foe when it dies."
msgstr "ilk vuruşu bir düşmanı işaretler; ekip ona +%15 hasar yapar; işaret düşman ölünce başka birine geçer."

#: scripts/autoload/game_data/GameDataPaths.gd:15 scripts/ui/GuildViews.gd:2436
msgid "Hunt"
msgstr "Av"

#: scripts/autoload/game_data/GameDataPaths.gd:15
msgid "move the Mark to any foe; their next hit on it does +60%."
msgstr "İşareti istediğin düşmana taşı; ona sonraki vuruşu +%60 hasar yapar."

#: scripts/autoload/game_data/GameDataPaths.gd:15
msgid "the first time they're hit, they can't be targeted for a round and their next hit on the Mark does triple."
msgstr "ilk kez vurulduğunda bir tur hedef alınamaz ve İşaretli düşmana sonraki vuruşu üç kat hasar yapar."

#: scripts/autoload/game_data/GameDataPaths.gd:15
msgid "two Marks at once."
msgstr "aynı anda iki İşaret."

#: scripts/autoload/game_data/GameDataPaths.gd:16
msgid "Evocation"
msgstr "Çağrım"

#: scripts/autoload/game_data/GameDataPaths.gd:16
msgid "builds heat until it explodes."
msgstr "patlayana kadar ısı biriktirir."

#: scripts/autoload/game_data/GameDataPaths.gd:16
msgid "each spell adds 1 Heat (+8% damage, up to 5); at 5 the next skill hits every foe and Heat resets."
msgstr "her büyü 1 Isı ekler (+%8 hasar, en fazla 5); 5'te sonraki beceri bütün düşmanları vurur ve Isı sıfırlanır."

#: scripts/autoload/game_data/GameDataPaths.gd:16
msgid "Flashpoint"
msgstr "Parlama Noktası"

#: scripts/autoload/game_data/GameDataPaths.gd:16
msgid "+3 Heat at once."
msgstr "bir anda +3 Isı."

#: scripts/autoload/game_data/GameDataPaths.gd:16
msgid "the first detonation in a fight leaves every foe burning for 3 rounds."
msgstr "bir dövüşteki ilk patlama bütün düşmanları 3 tur boyunca yakar."

#: scripts/autoload/game_data/GameDataPaths.gd:16
msgid "detonating drops Heat to 3, not 0."
msgstr "patlama Isıyı 0'a değil 3'e indirir."

#: scripts/autoload/game_data/GameDataPaths.gd:17
msgid "Warding"
msgstr "Koruyuculuk"

#: scripts/autoload/game_data/GameDataPaths.gd:17
msgid "keeps the party behind glass."
msgstr "ekibi camın ardında tutar."

#: scripts/autoload/game_data/GameDataPaths.gd:17
msgid "at the start of every round, the most-hurt ally gets a ward of 8% of max HP."
msgstr "her turun başında en yaralı müttefik azami canının %8'i kadar bir koruma alır."

#: locale/extra_msgids.txt scripts/autoload/game_data/GameDataPaths.gd:17
msgid "Sigil"
msgstr "Mühür"

#: scripts/autoload/game_data/GameDataPaths.gd:17
msgid "wards every ally for 12% of their max HP."
msgstr "her müttefiki azami canının %12'si kadar korur."

#: scripts/autoload/game_data/GameDataPaths.gd:17
msgid "the first time a ward breaks, every ward reflects damage for 2 rounds."
msgstr "bir koruma ilk kez kırıldığında her koruma 2 tur boyunca hasarı yansıtır."

#: scripts/autoload/game_data/GameDataPaths.gd:17
msgid "Ward Weave wards every ally each round."
msgstr "Koruma Örgüsü her tur her müttefiki korur."

#: scripts/autoload/game_data/GameDataPaths.gd:18
msgid "Augury"
msgstr "Kehanet Yolu"

#: scripts/autoload/game_data/GameDataPaths.gd:18
msgid "sees what's coming and bends it."
msgstr "geleceği görür ve büker."

#: scripts/autoload/game_data/GameDataPaths.gd:18
msgid "once a fight, the first heavy blow aimed at the party comes to nothing."
msgstr "dövüş başına bir kez, ekibe gelen ilk ağır darbe boşa gider."

#: scripts/autoload/game_data/GameDataPaths.gd:18
msgid "Twist Fate"
msgstr "Kaderi Bük"

#: scripts/autoload/game_data/GameDataPaths.gd:18
msgid "reroll a foe's next move."
msgstr "bir düşmanın sonraki hamlesini yeniden belirle."

#: scripts/autoload/game_data/GameDataPaths.gd:18
msgid "the first time a foe winds up, the whole party dodges the blow and gains 2 Momentum."
msgstr "bir düşman ilk kez güç topladığında bütün ekip o darbeden kaçar ve 2 İvme kazanır."

#: scripts/autoload/game_data/GameDataPaths.gd:18
msgid "two cancels a fight."
msgstr "dövüş başına iki kez."

#: scripts/autoload/game_data/GameDataPaths.gd:19
msgid "Mercy"
msgstr "Merhamet"

#: scripts/autoload/game_data/GameDataPaths.gd:19
msgid "healing that keeps on giving."
msgstr "vermeye devam eden şifa."

#: scripts/autoload/game_data/GameDataPaths.gd:19
msgid "Overflow"
msgstr "Taşma"

#: scripts/autoload/game_data/GameDataPaths.gd:19
msgid "half the healing past full HP becomes a ward."
msgstr "tam canı aşan şifanın yarısı korumaya dönüşür."

#: scripts/autoload/game_data/GameDataPaths.gd:19
msgid "Benediction"
msgstr "Kutsama"

#: scripts/autoload/game_data/GameDataPaths.gd:19
msgid "heals every ally for 10% of max HP."
msgstr "her müttefiki azami canının %10'u kadar iyileştirir."

#: scripts/autoload/game_data/GameDataPaths.gd:19
msgid "the first time an ally falls, they rise at 30% HP."
msgstr "bir müttefik ilk kez düştüğünde canının %30'uyla ayağa kalkar."

#: scripts/autoload/game_data/GameDataPaths.gd:19
msgid "Miracle works twice a fight."
msgstr "Mucize dövüş başına iki kez işler."

#: scripts/autoload/game_data/GameDataPaths.gd:20
msgid "the party is safer while they stand."
msgstr "o ayaktayken ekip daha güvende."

#: scripts/autoload/game_data/GameDataPaths.gd:20
msgid "while they stand, the party takes 6% less damage."
msgstr "o ayakta kaldıkça ekip %6 daha az hasar alır."

#: scripts/autoload/game_data/GameDataPaths.gd:20
msgid "Consecrate"
msgstr "Takdis"

#: scripts/autoload/game_data/GameDataPaths.gd:20
msgid "one ally takes no damage this round."
msgstr "bir müttefik bu tur hiç hasar almaz."

#: scripts/autoload/game_data/GameDataPaths.gd:20
msgid "the first time the party falls below half its total HP, damage taken is halved for 2 rounds."
msgstr "ekibin toplam canı ilk kez yarının altına düştüğünde alınan hasar 2 tur boyunca yarıya iner."

#: scripts/autoload/game_data/GameDataPaths.gd:20
msgid "Sanctuary is doubled."
msgstr "Sığınak iki katına çıkar."

#: scripts/autoload/game_data/GameDataPaths.gd:21
msgid "Zeal"
msgstr "Şevk"

#: scripts/autoload/game_data/GameDataPaths.gd:21
msgid "heals by hitting."
msgstr "vurarak iyileştirir."

#: scripts/autoload/game_data/GameDataPaths.gd:21
msgid "Fervor"
msgstr "Coşku"

#: scripts/autoload/game_data/GameDataPaths.gd:21
msgid "their attacks heal the most-hurt ally for 25% of the damage."
msgstr "saldırıları en yaralı müttefiki hasarın %25'i kadar iyileştirir."

#: scripts/autoload/game_data/GameDataPaths.gd:21 scripts/autoload/game_data/GameDataSkills.gd:321
msgid "Smite"
msgstr "Çarp"

#: scripts/autoload/game_data/GameDataPaths.gd:21
msgid "a 150% holy strike; Fervor heals double for it."
msgstr "%150'lik kutsal bir darbe; Coşku bunun için iki kat iyileştirir."

#: scripts/autoload/game_data/GameDataPaths.gd:21
msgid "their first kill in a fight hits every foe for half their attack and heals the party 10%."
msgstr "dövüşteki ilk öldürmesi her düşmanı saldırısının yarısı kadar vurur ve ekibi %10 iyileştirir."

#: scripts/autoload/game_data/GameDataPaths.gd:21
msgid "Fervor heals the whole party."
msgstr "Coşku bütün ekibi iyileştirir."

#: scripts/autoload/game_data/GameDataPaths.gd:22
msgid "Assassin"
msgstr "Suikastçı"

#: scripts/autoload/game_data/GameDataPaths.gd:22
msgid "finishes what others start."
msgstr "başkalarının başladığını bitirir."

#: scripts/autoload/game_data/GameDataPaths.gd:22
msgid "+50% damage to foes under 35% HP; a kill refunds 2 Momentum."
msgstr "canı %35'in altındaki düşmanlara +%50 hasar; bir öldürme 2 İvme iade eder."

#: scripts/autoload/game_data/GameDataPaths.gd:22
msgid "Shadowstep"
msgstr "Gölge Adımı"

#: scripts/autoload/game_data/GameDataPaths.gd:22
msgid "strikes any foe for 130%, past escorts and guards."
msgstr "herhangi bir düşmana %130 vurur, eskortları ve korumaları aşarak."

#: scripts/autoload/game_data/GameDataPaths.gd:22
msgid "their first kill in a fight gives them another action at once."
msgstr "dövüşteki ilk öldürmesi ona hemen bir hamle daha verir."

#: scripts/autoload/game_data/GameDataPaths.gd:22
msgid "Execute works under 50% HP."
msgstr "İnfaz %50 canın altında işler."

#: scripts/autoload/game_data/GameDataPaths.gd:23
msgid "can't be pinned down."
msgstr "köşeye sıkıştırılamaz."

#: scripts/autoload/game_data/GameDataPaths.gd:23
msgid "+15% dodge; each dodge gives 1 Momentum and a counter jab."
msgstr "+%15 kaçınma; her kaçınma 1 İvme ve bir karşı dürtme verir."

#: scripts/autoload/game_data/GameDataPaths.gd:23
msgid "Feint"
msgstr "Aldatmaca"

#: scripts/autoload/game_data/GameDataPaths.gd:23
msgid "until their next turn, half the attacks aimed at others go to them instead, and they have +25% dodge."
msgstr "sonraki sırasına kadar başkalarına gelen saldırıların yarısı ona yönelir ve +%25 kaçınması olur."

#: scripts/autoload/game_data/GameDataPaths.gd:23
msgid "after their third dodge in a fight, they can't be hit for 2 rounds."
msgstr "dövüşteki üçüncü kaçınmasından sonra 2 tur boyunca vurulamaz."

#: scripts/autoload/game_data/GameDataPaths.gd:23
msgid "counter jabs hit at full strength."
msgstr "karşı dürtmeler tam güçle vurur."

#: scripts/autoload/game_data/GameDataPaths.gd:24
msgid "Scrapper"
msgstr "Kavgacı"

#: scripts/autoload/game_data/GameDataPaths.gd:24
msgid "hard to put down."
msgstr "kolay yere serilmez."

#: scripts/autoload/game_data/GameDataPaths.gd:24
msgid "Scrappy"
msgstr "Kavgacılık"

#: scripts/autoload/game_data/GameDataPaths.gd:24
msgid "heals 15% of the damage they deal; +5% HP each round in the front row."
msgstr "verdiği hasarın %15'i kadar iyileşir; ön sıradayken her tur +%5 can."

#: scripts/autoload/game_data/GameDataPaths.gd:24
msgid "Dirty Trick"
msgstr "Kirli Numara"

#: scripts/autoload/game_data/GameDataPaths.gd:24
msgid "a hit that stuns the foe and gives 2 Momentum."
msgstr "düşmanı sersemleten ve 2 İvme veren bir vuruş."

#: scripts/autoload/game_data/GameDataPaths.gd:24
msgid "the first time they drop below 25% HP, they heal 50% and their next 2 attacks hit twice."
msgstr "canı ilk kez %25'in altına düştüğünde %50 iyileşir ve sonraki 2 saldırısı iki kez vurur."

#: scripts/autoload/game_data/GameDataPaths.gd:24
msgid "can't be stunned, and Scrappy heals 30%."
msgstr "sersemletilemez ve Kavgacılık %30 iyileştirir."

#: scripts/autoload/game_data/GameDataPaths.gd:30
msgid "Foes whose hits they take deal 10% less for the rest of the fight."
msgstr "Darbelerini üstlendiği düşmanlar dövüşün geri kalanında %10 daha az hasar verir."

#: scripts/autoload/game_data/GameDataPaths.gd:31
msgid "Each hit they take heals the ally it was aimed at for 5% of their max HP."
msgstr "Üstlendiği her darbe, hedef alınan müttefiki azami canının %5'i kadar iyileştirir."

#: scripts/autoload/game_data/GameDataPaths.gd:32
msgid "Takes 40% instead of 25%, but always acts last."
msgstr "%25 yerine %40 üstlenir ama her zaman en son davranır."

#: scripts/autoload/game_data/GameDataPaths.gd:33
msgid "Foes whose hits they take are chilled and act later next round."
msgstr "Darbelerini üstlendiği düşmanlar üşür ve sonraki tur geç davranır."

#: scripts/autoload/game_data/GameDataPaths.gd:34
msgid "Hold the Line also wards the back row for 10% of their max HP."
msgstr "Hattı Tut arka sırayı azami canlarının %10'u kadar da korur."

#: scripts/autoload/game_data/GameDataPaths.gd:35
msgid "Hold the Line costs 2 Momentum."
msgstr "Hattı Tut 2 İvme tutar."

#: scripts/autoload/game_data/GameDataPaths.gd:36
msgid "During Last Wall, every foe that hits them is stunned."
msgstr "Son Sur sırasında ona vuran her düşman sersemler."

#: scripts/autoload/game_data/GameDataPaths.gd:37
msgid "Reckless: +10% damage dealt and taken."
msgstr "Pervasız: verilen ve alınan hasar +%10."

#: scripts/autoload/game_data/GameDataPaths.gd:38
msgid "Blood Price costs 10% HP and the empowered hit cleaves."
msgstr "Kan Bedeli canın %10'u tutar ve güçlenen vuruş biçer."

#: scripts/autoload/game_data/GameDataPaths.gd:39
msgid "Heals 1% of damage dealt for every 4% of HP missing."
msgstr "Eksik canın her %4'ü için verdiği hasarın %1'i kadar iyileşir."

#: scripts/autoload/game_data/GameDataPaths.gd:40
msgid "Can't fall below 1 HP during Red Mist."
msgstr "Kızıl Sis sırasında canı 1'in altına düşmez."

#: scripts/autoload/game_data/GameDataPaths.gd:41
msgid "Starts every fight at 1 Combo."
msgstr "Her dövüşe 1 Seriyle başlar."

#: scripts/autoload/game_data/GameDataPaths.gd:42
msgid "When their Combo target attacks them, they counter and keep the stack."
msgstr "Seri hedefi ona saldırdığında karşı vurur ve seriyi korur."

#: scripts/autoload/game_data/GameDataPaths.gd:43
msgid "Each Combo stack also gives +3% dodge."
msgstr "Her Seri ayrıca +%3 kaçınma verir."

#: scripts/autoload/game_data/GameDataPaths.gd:44
msgid "Combo goes up to 6."
msgstr "Seri 6'ya kadar çıkar."

#: scripts/autoload/game_data/GameDataPaths.gd:45
msgid "During Perfect Form the whole party hits 15% harder."
msgstr "Kusursuz Duruş sırasında bütün ekip %15 daha sert vurur."

#: scripts/autoload/game_data/GameDataPaths.gd:46
msgid "At 4 Combo their hits ignore armor and wards."
msgstr "4 Seride vuruşları zırhı ve korumaları yok sayar."

#: scripts/autoload/game_data/GameDataPaths.gd:47
msgid "Steady shots break armor."
msgstr "Sabit atışlar zırhı kırar."

#: scripts/autoload/game_data/GameDataPaths.gd:48
msgid "Steady Aim still holds after one hit."
msgstr "Sabit Nişan bir vuruştan sonra da korunur."

#: scripts/autoload/game_data/GameDataPaths.gd:49
msgid "Needs two quiet rounds, but gives +70%."
msgstr "İki sakin tur gerekir ama +%70 verir."

#: scripts/autoload/game_data/GameDataPaths.gd:50
msgid "Called Shot also hits every foe under 40% HP."
msgstr "Nişanlı Atış canı %40'ın altındaki her düşmanı da vurur."

#: scripts/autoload/game_data/GameDataPaths.gd:51
msgid "Can use Called Shot from the front row."
msgstr "Nişanlı Atış'ı ön sıradan da kullanabilir."

#: scripts/autoload/game_data/GameDataPaths.gd:52
msgid "Held Breath shots ignore wards."
msgstr "Tutulan Nefes atışları korumaları yok sayar."

#: scripts/autoload/game_data/GameDataPaths.gd:53
msgid "Snares do double damage."
msgstr "Tuzaklar iki kat hasar verir."

#: scripts/autoload/game_data/GameDataPaths.gd:54
msgid "Snared foes' hits are 10% weaker; rift hazards are 20% weaker."
msgstr "Tuzağa düşen düşmanların vuruşları %10 daha zayıf; yarık tehlikeleri %20 daha zayıf."

#: scripts/autoload/game_data/GameDataPaths.gd:55
