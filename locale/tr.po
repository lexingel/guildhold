msgid "+2 Healing Tonics."
msgstr "+2 Şifa Toniği."

#: scripts/autoload/game_data/GameDataModes.gd:143 scripts/autoload/game_data/GameDataModes.gd:183 scripts/autoload/game_state/GameStateBreach.gd:535
msgid "Send them on"
