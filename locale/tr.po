msgstr "Yolunu seç — haritada bir noktaya tıkla."

#: scripts/ui/RiftRunView.gd:228
msgid " — Floor %d"
msgstr " — Kat %d"

#: scripts/ui/RiftRunView.gd:230
msgid " — the Descent, depth %d"
msgstr " — İniş, derinlik %d"

#: scripts/ui/RiftRunView.gd:233
