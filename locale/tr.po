msgstr "Sahra hekimi"

#: scripts/autoload/game_data/GameDataModes.gd:638
msgid "Light fingers"
msgstr "Uzun parmaklar"

#: scripts/autoload/game_data/GameDataModes.gd:639
msgid "Takes the blows"
msgstr "Darbeleri o alır"

#: scripts/autoload/game_data/GameDataModes.gd:640
msgid "At home in danger"
msgstr "Tehlikede evinde gibi"

#: scripts/autoload/game_data/GameDataModes.gd:641
msgid "Drills the others"
msgstr "Ötekileri çalıştırır"

#: scripts/autoload/game_data/GameDataModes.gd:642
msgid "Clean shot"
msgstr "Temiz atış"

#: scripts/autoload/game_data/GameDataModes.gd:643
msgid "Sets snares"
msgstr "Tuzak kurar"

#: scripts/autoload/game_data/GameDataModes.gd:644
msgid "Bounty hunter"
msgstr "Ödül avcısı"

#: scripts/autoload/game_data/GameDataModes.gd:645
msgid "Burns the dross"
msgstr "Cürufu yakar"

#: scripts/autoload/game_data/GameDataModes.gd:646
msgid "Wards the camp"
msgstr "Kampı korur"

#: scripts/autoload/game_data/GameDataModes.gd:647
msgid "Sees it coming"
msgstr "Geleceği görür"

#: scripts/autoload/game_data/GameDataModes.gd:648
msgid "Patches everyone"
msgstr "Herkesi yamar"

#: scripts/autoload/game_data/GameDataModes.gd:649
msgid "Shields the worst of it"
msgstr "En kötüsünü karşılar"

#: scripts/autoload/game_data/GameDataModes.gd:650
msgid "Rallies the party"
msgstr "Grubu toparlar"

#: scripts/autoload/game_data/GameDataModes.gd:651
msgid "Quiet work"
msgstr "Sessiz iş"

#: scripts/autoload/game_data/GameDataModes.gd:652
msgid "Gets out fast"
msgstr "Çabuk sıvışır"

#: scripts/autoload/game_data/GameDataModes.gd:653
msgid "Shrugs it off"
msgstr "Silkip atar"

#: scripts/autoload/game_data/GameDataModes.gd:1003 scripts/autoload/game_data/GameDataModes.gd:711 scripts/autoload/game_data/GameDataModes.gd:734
msgid "SS"
msgstr "SS"

#: scripts/autoload/game_data/GameDataModes.gd:735
msgid "SSS"
msgstr "SSS"

#: scripts/autoload/game_data/GameDataModes.gd:746
msgid "more elites"
msgstr "daha çok seçkin"

#: scripts/autoload/game_data/GameDataModes.gd:746
msgid "harsher hazards"
msgstr "daha sert tehlikeler"

#: scripts/autoload/game_data/GameDataModes.gd:746
msgid "fewer shops"
msgstr "daha az dükkân"

#: scripts/autoload/game_data/GameDataModes.gd:747
msgid "no rarity floor on the starting relic"
msgstr "başlangıç kalıntısında nadirlik alt sınırı yok"

#: scripts/autoload/game_data/GameDataModes.gd:747
msgid "bosses use two mechanics"
msgstr "bosslar iki mekanik kullanır"

#: scripts/autoload/game_data/GameDataModes.gd:753
msgid "Forks offer elite fights more often."
msgstr "Ayrımlar daha sık seçkin dövüşü sunar."

#: scripts/autoload/game_data/GameDataModes.gd:754
msgid "The mildest hazards are skipped: every hazard is at least Moderate (at least Severe at SSS)."
msgstr "En hafif tehlikeler atlanır: her tehlike en az Orta (SSS'de en az Ağır)."

#: scripts/autoload/game_data/GameDataModes.gd:755
msgid "Forks offer a shop less often."
msgstr "Ayrımlar daha seyrek dükkân sunar."

#: scripts/autoload/game_data/GameDataModes.gd:756
msgid "The starting relic can be any rarity, even Common."
msgstr "Başlangıç kalıntısı her nadirlikte olabilir, Sıradan bile."

#: scripts/autoload/game_data/GameDataModes.gd:757
msgid "The boss uses two of its mechanics at once."
msgstr "Boss iki mekaniğini aynı anda kullanır."

#: scripts/autoload/game_data/GameDataModes.gd:785
msgid "Operations Branch"
msgstr "Operasyon Dalı"

#: scripts/autoload/game_data/GameDataModes.gd:785
msgid "Heroes & Combat"
msgstr "Kahramanlar ve Dövüş"

#: scripts/autoload/game_data/GameDataModes.gd:786 scripts/autoload/game_data/GameDataModes.gd:900
msgid "Barracks"
msgstr "Kışla"

#: scripts/autoload/game_data/GameDataModes.gd:786
msgid "+2 hero slots"
msgstr "+2 kahraman yeri"

