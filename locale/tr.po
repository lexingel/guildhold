#: scripts/autoload/game_data/GameDataModes.gd:684
msgid "Contracts pay 15% less Gold, and heroes ask 15% lower wages."
msgstr "Sözleşmeler %15 daha az Altın öder ve kahramanlar %15 daha düşük maaş ister."

#: scripts/autoload/game_data/GameDataModes.gd:685
