msgstr "Bir kalıntı satıcısı"

#: scripts/autoload/game_data/GameDataModes.gd:118
msgid "A hooded peddler unwraps a single relic and names a steep price."
msgstr "Kukuletalı bir satıcı tek bir kalıntıyı açıyor ve yüksek bir fiyat söylüyor."

#: scripts/autoload/game_data/GameDataModes.gd:119
