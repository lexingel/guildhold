msgstr "Köy hasat şenliğini düzenliyor ve ziyafeti loncanın ödemesini umuyor."

#: scripts/autoload/game_data/GameDataModes.gd:122
msgid "Refugees at the gate"
msgstr "Kapıda mülteciler"

#: scripts/autoload/game_data/GameDataModes.gd:122
msgid "Families fleeing a broken rift ask for shelter and bread. Word of it would travel."
msgstr "Taşan bir yarıktan kaçan aileler barınak ve ekmek istiyor. Bunun haberi yayılır."

#: scripts/autoload/game_data/GameDataModes.gd:123
msgid "A debt collector"
msgstr "Bir alacaklı"

#: scripts/autoload/game_data/GameDataModes.gd:123
msgid "A clerk arrives with a debt the guild's founders left unpaid, with interest. Refusing would be talked about."
msgstr "Bir kâtip, loncanın kurucularından kalma ödenmemiş bir borçla, faiziyle birlikte geliyor. Reddetmek dillere düşer."

#: scripts/autoload/game_data/GameDataModes.gd:124
