msgstr "Azim: göğüslersen -%d, riske girersen -%d, kat için de -%d"

#: scripts/ui/RiftRunView.gd:40
msgid "Resolve: +%d if you rest (+%d otherwise), then -%d for the floor"
msgstr "Azim: dinlenirsen +%d (yoksa +%d), sonra kat için -%d"

#: scripts/ui/RiftRunView.gd:42
msgid "Resolve: +%d, then -%d for the floor"
msgstr "Azim: +%d, sonra kat için -%d"

