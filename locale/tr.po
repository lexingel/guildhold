msgstr "Bu yarığın bölgesi hangi düşmanlarla karşılaşacağını belirler."

#: scripts/ui/RiftRunView.gd:253
msgid "Relic ward %d"
msgstr "Kalıntı koruması %d"

#: scripts/ui/RiftRunView.gd:258
